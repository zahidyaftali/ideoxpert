---
// Layout for the privacy policy and terms: page hero, sticky contents list
// built from the <h2 id> headings in the slot, and the text itself.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';

interface Props {
	title: string;
	description: string;
	keywords?: string;
	image?: string;
	breadcrumbs: { name: string; path: string }[];
	heading: string;
	updated: string;
}

const { heading, updated, breadcrumbs, ...meta } = Astro.props;
const html = await Astro.slots.render('default');
const toc = [...html.matchAll(/<h2 id="([^"]+)">([\s\S]*?)<\/h2>/g)].map(([, id, text]) => ({ id, text }));
const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout {...meta} breadcrumbs={breadcrumbs}>
	<PageHero crumbs={breadcrumbs} eyebrow={`Last updated ${updated}`} title={`${heading}<span class="dot">.</span>`} />

	<section class="section section--white legal">
		<div class="container legal__grid">
			<nav class="legal__toc" aria-label="On this page">
				<span class="index">On this page</span>
				<ol role="list">
					{toc.map((t, i) => (
						<li><a href={`#${t.id}`}><span class="index">{pad(i + 1)}</span><span set:html={t.text} /></a></li>
					))}
				</ol>
			</nav>
			<article class="prose" set:html={html} />
		</div>
	</section>
</BaseLayout>

<script>
	// Highlight the section currently being read in the contents list.
	const links = new Map(
		[...document.querySelectorAll<HTMLAnchorElement>('.legal__toc a')].map((a) => [a.hash.slice(1), a]),
	);
	const io = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				links.forEach((a) => a.classList.remove('is-current'));
				links.get(e.target.id)?.classList.add('is-current');
			}
		},
		{ rootMargin: '-20% 0px -70% 0px' },
	);
	document.querySelectorAll('.prose h2[id]').forEach((h) => io.observe(h));
</script>

<style>
	.legal {
		--sy-t: clamp(56px, 7vw, 96px);
	}

	.legal__grid {
		display: grid;
		gap: 48px;
	}

	@media (min-width: 1024px) {
		.legal__grid {
			grid-template-columns: 280px 1fr;
			gap: 96px;
		}

		.legal__toc {
			position: sticky;
			top: 110px;
			align-self: start;
		}
	}

	.legal__toc {
		display: grid;
		gap: 16px;
	}

	.legal__toc ol {
		display: grid;
		margin: 0;
		border-left: 1px solid var(--line);
	}

	.legal__toc a {
		position: relative;
		display: grid;
		grid-template-columns: 28px 1fr;
		gap: 8px;
		padding: 7px 0 7px 16px;
		font-size: 0.875rem;
		color: var(--muted);
		transition: color 0.3s;
	}

	.legal__toc a::before {
		content: '';
		position: absolute;
		left: -1px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--green);
		transform: scaleY(0);
		transition: transform 0.4s var(--ease-out);
	}

	.legal__toc a:hover,
	.legal__toc a.is-current {
		color: var(--ink);
	}

	.legal__toc a.is-current::before {
		transform: scaleY(1);
	}

	@media (max-width: 1023px) {
		.legal__toc {
			display: none;
		}
	}

	.prose {
		max-width: 72ch;
		color: var(--ink-soft);
	}

	.prose :global(h2) {
		margin: 56px 0 16px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
		font-size: 1.625rem;
		font-weight: 550;
		letter-spacing: -0.03em;
		line-height: 1.2;
		color: var(--ink);
		scroll-margin-top: 110px;
	}

	.prose :global(h2:first-child) {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}

	.prose :global(p),
	.prose :global(ul) {
		margin-bottom: 16px;
	}

	.prose :global(ul) {
		padding-left: 0;
		list-style: none;
		display: grid;
		gap: 10px;
	}

	.prose :global(li) {
		position: relative;
		padding-left: 22px;
	}

	.prose :global(li)::before {
		content: '';
		position: absolute;
		left: 2px;
		top: 0.7em;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--green);
	}

	.prose :global(strong) {
		color: var(--ink);
		font-weight: 600;
	}

	.prose :global(a) {
		color: var(--green-ink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.prose :global(.legal__ack) {
		margin-top: 48px;
		padding: 20px 24px;
		border-left: 3px solid var(--green);
		background: var(--green-50);
		color: var(--ink);
	}
</style>

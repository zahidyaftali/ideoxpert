		justify-content: space-between;
		font-size: 1.375rem;
		letter-spacing: -0.03em;
		font-weight: 500;
	}

	.mega-link__label :global(svg) {
		color: var(--green-ink);
		transform: translateX(-8px);
		opacity: 0;
		transition:
			transform 0.5s var(--ease-out),
			opacity 0.3s;
	}

	.mega-link:hover .mega-link__label :global(svg) {
		transform: none;
		opacity: 1;
	}

	.mega-link__text {
		font-size: 0.875rem;
		color: var(--muted);

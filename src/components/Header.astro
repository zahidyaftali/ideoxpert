		isolation: isolate;
		display: grid;
		gap: 6px;
		align-content: start;
		padding: 28px;
		background: var(--paper);
		font-size: 0.875rem;
		font-style: normal;
		color: var(--muted);
	}

	.mega-office address {
		font-style: normal;
	}

	.mega-office__city {
		font-size: 2rem;
		letter-spacing: -0.045em;
		font-weight: 400;
		color: var(--ink);
		margin-top: 6px;
	}

	.mega-office__text {
		margin-bottom: 14px;
	}

	/* ---------- Industries: picture tiles, like the reference ---------- */
	.mega--tiles {
		background: transparent;
		border-bottom: 0;
		box-shadow: none;
		pointer-events: none;
	}

	.mega__inner--tiles {
		display: flex;
		justify-content: center;
		padding-block: 0;
	}

	.itiles {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 300px));
		margin: 0;
		background: var(--card);
		box-shadow: 0 24px 48px rgba(7, 16, 11, 0.18);
		pointer-events: auto;
	}

	.itile {
		position: relative;
		display: block;
		aspect-ratio: 300 / 274;
		overflow: hidden;
		isolation: isolate;
		background: var(--night);
		color: #fff;
	}

	.itile__media img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
	}

	.itile__label {
		position: absolute;
		left: 24px;
		right: 24px;
		bottom: 30px;
		z-index: 1;
		font-size: clamp(1.5rem, 1rem + 0.9vw, 2rem);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.02em;
		transition: transform 0.3s ease;
	}

	.itile__arrow {
		position: absolute;
		top: 24px;
		right: 24px;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border: 2px solid currentColor;
		opacity: 0;
		transform: translate(8px, -8px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease,
			background-color 0.3s ease;
	}

	.itile:hover .itile__arrow,
	.itile:focus-visible .itile__arrow {
		opacity: 1;
		transform: none;
		background: rgba(255, 255, 255, 0.08);
	}

	.itile:hover .itile__media img {
		transform: scale(1.04);
	}

	.itile:hover .itile__label {
		transform: translateY(-2px);
	}

	.itile:focus-visible {
		outline: 2px solid var(--green);
		outline-offset: -2px;
	}

	/* Last tile: light, with a small pixel mark, like the reference's "All Industries_". */
	.itile--light {
		background: var(--card);
		color: var(--ink);
	}

	.itile--light .itile__label {
		font-size: clamp(1.25rem, 0.9rem + 0.7vw, 1.625rem);
	}

	.itile--light:hover .itile__arrow {
		background: rgba(13, 18, 16, 0.05);
	}

	.itile__icon {
		position: absolute;
		left: 24px;
		bottom: 76px;
		width: 28px;
		height: 28px;
		fill: var(--green);
	}

	.itile__icon .itile__icon-dim {
		fill: var(--green);
		opacity: 0.3;
	}

	.mega-office :global(.countries) {
		margin-bottom: 18px;
	}

	.scrim {
		position: fixed;
		inset: 0;
		z-index: 90;
		background: rgba(7, 16, 11, 0.32);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.5s var(--ease-out),
			visibility 0s linear 0.5s;
	}

	:global(.mega-open) .scrim {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.5s var(--ease-out);
	}

	/* ---------- Mobile drawer ---------- */
	.drawer {
		position: fixed;
		inset: 0;
		z-index: 95;
		padding-top: calc(var(--header-h) + var(--topbar-h));
		color: var(--on-night);
		overflow-y: auto;
		overscroll-behavior: contain;
		visibility: hidden;
		pointer-events: none;
		transition: visibility 0s linear 0.8s;
	}

	.drawer__bg {
		position: fixed;
		inset: 0;
		z-index: -1;
		background: var(--night);
		clip-path: inset(0 0 100% 0);
		transition: clip-path 0.8s var(--ease-in-out);
	}

	:global(.drawer-open) .drawer {
		visibility: visible;
		pointer-events: auto;
		transition: none;
	}

	:global(.drawer-open) .drawer__bg {
		clip-path: inset(0 0 0 0);
	}

	:global(.drawer-open) .site-header .navbar {
		background: var(--night);
		border-bottom-color: var(--night-line);
	}

	:global(.drawer-open) .brand img {
		filter: brightness(0) invert(1);
	}

	:global(.drawer-open) .burger {
		background: var(--green);
	}

	:global(.drawer-open) .burger span {
		background: var(--ink);
	}

	.drawer__nav {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		padding-block: 24px 40px;
	}

	.drawer__list {
		margin: 0;
	}

	.drawer__list > li,
	.drawer__foot {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.4s,
			transform 0.4s var(--ease-out);
	}

	:global(.drawer-open) .drawer__list > li,
	:global(.drawer-open) .drawer__foot {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.7s var(--ease-out),
			transform 0.9s var(--ease-out);
		transition-delay: calc(300ms + var(--i) * 70ms);
	}

	.drawer__link {
		display: flex;
		align-items: baseline;
		gap: 14px;
		padding: 18px 0;
		border-bottom: 1px solid var(--night-line);
		font-size: clamp(2rem, 8vw, 2.75rem);
		letter-spacing: -0.045em;
		line-height: 1.1;
		cursor: pointer;
		list-style: none;
	}

	.drawer__link::-webkit-details-marker {
		display: none;
	}

	.drawer__link :global(.drawer__plus) {
		margin-left: auto;
		align-self: center;
		transition: transform 0.5s var(--ease-out);
	}

	.drawer__group[open] :global(.drawer__plus) {
		transform: rotate(45deg);
	}

	.drawer__sub {
		display: grid;
		gap: 2px;
		padding: 14px 0 18px 36px;
		margin: 0;
		border-bottom: 1px solid var(--night-line);
	}

	.drawer__sub a {
		display: block;
		padding: 7px 0;
		color: var(--on-night-muted);
		font-size: 1.0625rem;
	}

	.drawer__sub a:hover,
	.drawer__all {
		color: var(--on-night) !important;
	}

	.drawer__all {
		display: inline-flex !important;
		align-items: center;
		gap: 8px;
	}

	.drawer__foot {
		display: grid;
		gap: 10px;
		margin-top: auto;
		padding-top: 48px;
	}

	.drawer__mail {
		font-size: 1.375rem;
		letter-spacing: -0.03em;
	}

	.drawer__phone {
		color: var(--on-night-muted);
		margin-bottom: 18px;
	}

	@media (min-width: 1100px) {
		.drawer {
			display: none;
		}
	}
</style>

<script>
	import { lenis } from '../scripts/smooth';

	const root = document.documentElement;
	const header = document.querySelector<HTMLElement>('[data-header]')!;
	const scrim = document.querySelector<HTMLElement>('[data-scrim]')!;
	const items = [...document.querySelectorAll<HTMLElement>('[data-mega-item]')];
	const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;
	const fine = matchMedia('(hover: hover) and (pointer: fine)');

	/* Hide on the way down, return on the way up. */
	let lastY = scrollY;
	let ticking = false;
	const onScroll = () => {
		const y = scrollY;
		const busy = root.classList.contains('mega-open') || root.classList.contains('drawer-open');
		header.classList.toggle('is-scrolled', y > 8);
		if (!busy) {
			if (y > lastY + 6 && y > 360) header.classList.add('is-hidden');
			else if (y < lastY - 6) header.classList.remove('is-hidden');
		}
		lastY = y;
		ticking = false;
	};
	addEventListener('scroll', () => {
		if (!ticking) {
			ticking = true;
			requestAnimationFrame(onScroll);
		}
	}, { passive: true });
	onScroll();

	/* Mega menus. One shared timer for every item: moving from one menu to the
	   next cancels the pending close, so the new menu never gets shut by the
	   old one. While a menu is already open, switching is instant. */
	let timer = 0;
	let current: HTMLElement | null = null;

	const setOpen = (item: HTMLElement, open: boolean) => {
		item.classList.toggle('is-open', open);
		item.querySelector('.nav__link')!.setAttribute('aria-expanded', String(open));
	};
	const loadImages = (item: HTMLElement) =>
		item.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
			img.src = img.dataset.src!;
			img.removeAttribute('data-src');
		});
	const open = (item: HTMLElement) => {
		clearTimeout(timer);
		if (current === item) return;
		loadImages(item);
		const switching = current !== null;
		header.classList.toggle('mega-switch', switching);
		if (current) setOpen(current, false);
		setOpen(item, true);
		current = item;
		root.classList.add('mega-open');
		header.classList.add('has-mega');
		if (switching) requestAnimationFrame(() => requestAnimationFrame(() => header.classList.remove('mega-switch')));
	};
	const close = () => {
		clearTimeout(timer);
		if (current) setOpen(current, false);
		current = null;
		root.classList.remove('mega-open');
		header.classList.remove('has-mega');
	};
	const later = (fn: () => void, ms: number) => {
		clearTimeout(timer);
		timer = window.setTimeout(fn, ms);
	};

	items.forEach((item) => {
		const button = item.querySelector<HTMLButtonElement>('.nav__link')!;
		item.addEventListener('pointerenter', (e) => {
			if (e.pointerType !== 'mouse' || !fine.matches) return;
			loadImages(item); // start fetching during the open delay
			current ? open(item) : later(() => open(item), 80);
		});
		item.addEventListener('pointerleave', (e) => {
			if (e.pointerType !== 'mouse' || !fine.matches) return;
			later(close, 220);
		});
		button.addEventListener('click', () => (current === item ? close() : open(item)));
		// Tabbing out of an open menu closes it.
		item.addEventListener('focusout', (e) => {
			if (current === item && !item.contains(e.relatedTarget as Node)) close();
		});
	});
	// Plain nav links (Contact) close an open menu when hovered.
	document.querySelectorAll<HTMLElement>('.nav__item:not([data-mega-item])').forEach((el) =>
		el.addEventListener('pointerenter', () => current && later(close, 120)),
	);
	scrim.addEventListener('click', close);

	/* Mobile drawer */
	const setDrawer = (openDrawer: boolean) => {
		root.classList.toggle('drawer-open', openDrawer);
		burger.setAttribute('aria-expanded', String(openDrawer));
		burger.setAttribute('aria-label', openDrawer ? 'Close menu' : 'Open menu');
		header.classList.remove('is-hidden');
		openDrawer ? lenis?.stop() : lenis?.start();
	};
	burger.addEventListener('click', () => setDrawer(!root.classList.contains('drawer-open')));
	document.querySelectorAll('[data-drawer] a').forEach((a) => a.addEventListener('click', () => setDrawer(false)));

	addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		if (current) {
			const button = current.querySelector<HTMLElement>('.nav__link')!;
			close();
			button.focus();
		}
		if (root.classList.contains('drawer-open')) {
			setDrawer(false);
			burger.focus();
		}
	});
	matchMedia('(min-width: 1100px)').addEventListener('change', (e) => e.matches && setDrawer(false));
</script>

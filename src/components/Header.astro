---
import { site, services } from '../data/site';
import { projects } from '../data/projects';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Countries from './Countries.astro';
import { industries } from '../data/industries';

interface Props {
	path: string;
}

const { path } = Astro.props;
const serviceSlugs = services.map((s) => `/${s.slug}`);
const active = {
	services: path === '/services' || serviceSlugs.includes(path),
	work: path === '/portfolio' || path.startsWith('/work/'),
	industries: path.startsWith('/industries') || path.startsWith('/locations'),
	blog: path.startsWith('/blog'),
	company: path === '/about' || path === '/privacy-policy' || path === '/terms-and-condition',
	contact: path === '/contact',
};
const latest = projects[0];

// Industries menu: six industries, where we work, and all industries.
const tiles = [
	...industries.map((ind) => ({ href: `/industries/${ind.slug}`, label: ind.short, image: `/assets/images/industries/${ind.slug}.webp` })),
	{ href: '/locations', label: 'Where we work', image: '/assets/images/industries/where-we-work.webp' },
	{ href: '/industries', label: 'All Industries', image: '' },
];
// Menu images load when a menu first opens, not with the page.
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const menuProjects = projects.slice(0, 4);

const companyLinks = [
	{ href: '/about', label: 'About us', text: 'Our story, what drives us and how we work.' },
	{ href: '/portfolio', label: 'Portfolio', text: 'Websites we have designed and built.' },
	{ href: '/contact', label: 'Contact', text: 'Get a free consultation. We reply within 24 hours.' },
];
---
<div class="progress" data-progress aria-hidden="true"></div>

<header class="site-header" data-header>
	<div class="topbar">
		<div class="container topbar__inner">
			<p class="topbar__text">
				<Icon name="spark" size={15} />
				<span><span class="topbar__label">Recently launched:</span> {latest.name}<span class="topbar__cat">, {latest.industry.toLowerCase()}</span>.</span>
			</p>
			<a class="topbar__cta" href={`/work/${latest.slug}`}>See the case study <Icon name="arrow-right" size={13} /></a>
		</div>
	</div>

	<div class="navbar">
		<div class="container navbar__inner">
			<a class="brand" href="/" aria-label="IdeoXpert home">
				<img src="/assets/images/Logo-600.png" alt="IdeoXpert" width="600" height="124" />
			</a>

			<nav class="nav" aria-label="Main">
				<ul class="nav__list" role="list">
					<!-- Services -->
					<li class="nav__item" data-mega-item>
						<button class:list={['nav__link', { 'is-active': active.services }]} aria-expanded="false" aria-controls="mega-services">
							Services <Icon name="chevron-down" size={14} class="nav__chev" />
						</button>
						<div class="mega" id="mega-services">
							<div class="container mega__inner mega__inner--services">
								<div class="mega__main">
									<div class="mega__head">
										<span class="mega__title">What we do</span>
										<a class="link link--green" href="/services">All services <Icon name="arrow-right" /></a>
									</div>
									<ul class="mega-svcs" role="list">
										{services.map((s, i) => (
											<li style={`--i:${i}`}>
												<a class:list={['mega-svc spot', { 'is-current': path === `/${s.slug}` }]} href={`/${s.slug}`} data-spot>
													<span class="mega-svc__name">{s.name}</span>
													<span class="mega-svc__sum">{s.summary}</span>
													<Icon name="arrow-up-right" size={18} class="mega-svc__arrow" />
												</a>
											</li>
										))}
									</ul>
								</div>
								<aside class="mega-card grain grain--dark">
									<div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
									<div class="tex-layer tex-dots tex-dots--light tex-fade" aria-hidden="true"></div>
									<span class="eyebrow">Free consultation</span>
									<p class="mega-card__title">Not sure which service you need? Ask us.</p>
									<p class="mega-card__text">We start every project with a free consultation, then send a clear quote with no hidden charges.</p>
									<Button href="/contact" variant="light" size="sm">Book a free call</Button>
								</aside>
							</div>
						</div>
					</li>

					<!-- Work -->
					<li class="nav__item" data-mega-item>
						<button class:list={['nav__link', { 'is-active': active.work }]} aria-expanded="false" aria-controls="mega-work">
							Work <Icon name="chevron-down" size={14} class="nav__chev" />
						</button>
						<div class="mega" id="mega-work">
							<div class="container mega__inner mega__inner--work">
								<div class="mega__head">
									<span class="mega__title">Recent work</span>
									<a class="link link--green" href="/portfolio">All {projects.length} projects <Icon name="arrow-right" /></a>
								</div>
								<ul class="mega-work" role="list">
									{menuProjects.map((p, i) => (
										<li style={`--i:${i}`}>
											<a class="mega-proj" href={`/work/${p.slug}`}>
												<span class="mega-proj__img media"><img src={blank} data-src={p.thumb} alt="" width="1440" height="900" decoding="async" /></span>
												<span class="mega-proj__meta">
													<span class="mega-proj__name">{p.name}</span>
													<span class="mega-proj__cat">{p.industry}</span>
												</span>
											</a>
										</li>
									))}
								</ul>
							</div>
						</div>
					</li>

					<!-- Industries -->
					<li class="nav__item" data-mega-item>
						<button class:list={['nav__link', { 'is-active': active.industries }]} aria-expanded="false" aria-controls="mega-industries">
							Industries <Icon name="chevron-down" size={14} class="nav__chev" />
						</button>
						<div class="mega mega--tiles" id="mega-industries">
							<div class="container mega__inner mega__inner--tiles">
								<!-- Picture tiles like the reference: short name + underscore, arrow on hover. Images load on first open. -->
								<ul class="itiles" role="list">
									{tiles.map((t, i) => (
										<li style={`--i:${i}`}>
											<a class:list={['itile', { 'itile--light': !t.image, 'is-current': path === t.href }]} href={t.href}>
												{t.image ? (
													<span class="itile__media" aria-hidden="true"><img src={blank} data-src={t.image} alt="" width="300" height="274" decoding="async" /></span>
												) : (
													<svg class="itile__icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M2 2h7v7H2zM10.5 2h7v7h-7zM19 10.5h7v7h-7zM2 10.5h7v7H2zM10.5 19h7v7h-7zM19 19h7v7h-7z" /><path class="itile__icon-dim" d="M19 2h7v7h-7zM10.5 10.5h7v7h-7zM2 19h7v7H2z" /></svg>
												)}
												<span class="itile__arrow" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
												<span class="itile__label">{t.label}_</span>
											</a>
										</li>
									))}
								</ul>
							</div>
						</div>
					</li>

					<!-- About -->
					<li class="nav__item" data-mega-item>
						<button class:list={['nav__link', { 'is-active': active.company }]} aria-expanded="false" aria-controls="mega-company">
							About <Icon name="chevron-down" size={14} class="nav__chev" />
						</button>
						<div class="mega" id="mega-company">
							<div class="container mega__inner mega__inner--company">
								<ul class="mega-links" role="list">
									{companyLinks.map((l, i) => (
										<li style={`--i:${i}`}>
											<a class="mega-link" href={l.href}>
												<span class="mega-link__label">{l.label} <Icon name="arrow-right" size={16} /></span>
												<span class="mega-link__text">{l.text}</span>
											</a>
										</li>
									))}
								</ul>
								<div class="mega-office">
									<div class="tex-layer tex-dots tex-fade" aria-hidden="true"></div>
									<p class="mega-office__city">Based in Islamabad<span class="dot">.</span></p>
									<p class="mega-office__text">Working with businesses across the world, from first websites to full rebuilds.</p>
									<Countries names={false} />
									<a class="link" href={`mailto:${site.email}`}>{site.email}</a>
								</div>
							</div>
						</div>
					</li>

					<li class="nav__item">
						<a class:list={['nav__link', { 'is-active': active.blog }]} href="/blog">Blog</a>
					</li>
					<li class="nav__item">
						<a class:list={['nav__link', { 'is-active': active.contact }]} href="/contact">Contact</a>
					</li>
				</ul>
			</nav>

			<div class="navbar__actions">
				<a class="icon-btn" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
					<Icon name="whatsapp" size={18} />
				</a>
				<Button href="/contact" variant="primary" size="sm" class="navbar__cta" magnetic>Get a free quote</Button>
				<button class="burger" aria-expanded="false" aria-controls="drawer" aria-label="Open menu" data-burger>
					<span></span><span></span>
				</button>
			</div>
		</div>
	</div>
</header>

<div class="scrim" data-scrim aria-hidden="true"></div>

<!-- Mobile menu -->
<div class="drawer" id="drawer" data-drawer>
	<div class="drawer__bg grain grain--dark" aria-hidden="true">
	</div>
	<nav class="drawer__nav container" aria-label="Mobile">
		<ul class="drawer__list" role="list">
			<li style="--i:0">
				<details class="drawer__group">
					<summary class="drawer__link">Services<Icon name="plus" size={22} class="drawer__plus" /></summary>
					<ul class="drawer__sub" role="list">
						{services.map((s) => <li><a href={`/${s.slug}`}>{s.name}</a></li>)}
						<li><a href="/services" class="drawer__all">All services <Icon name="arrow-right" size={16} /></a></li>
					</ul>
				</details>
			</li>
			<li style="--i:1"><a class="drawer__link" href="/portfolio">Work</a></li>
			<li style="--i:2">
				<details class="drawer__group">
					<summary class="drawer__link">Industries<Icon name="plus" size={22} class="drawer__plus" /></summary>
					<ul class="drawer__sub" role="list">
						{industries.map((ind) => <li><a href={`/industries/${ind.slug}`}>{ind.name}</a></li>)}
						<li><a href="/locations">Where we work</a></li>
						<li><a href="/industries" class="drawer__all">All industries <Icon name="arrow-right" size={16} /></a></li>
					</ul>
				</details>
			</li>
			<li style="--i:3"><a class="drawer__link" href="/about">About</a></li>
			<li style="--i:4"><a class="drawer__link" href="/blog">Blog</a></li>
			<li style="--i:5"><a class="drawer__link" href="/contact">Contact</a></li>
		</ul>
		<div class="drawer__foot" style="--i:6">
			<a href={`mailto:${site.email}`} class="drawer__mail">{site.email}</a>
			<a href={`tel:${site.phone}`} class="drawer__phone">{site.phoneDisplay}</a>
			<div class="btn-row">
				<Button href="/contact" variant="primary">Get a free quote</Button>
				<Button href={`https://wa.me/${site.whatsapp}`} variant="ghost-light" icon="whatsapp" external>WhatsApp</Button>
			</div>
		</div>
	</nav>
</div>

<style>
	/* ---------- Shell ---------- */
	.site-header {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 100;
		transition: transform 0.45s var(--ease-out);
	}

	.site-header.is-scrolled {
		transform: translateY(calc(var(--topbar-h) * -1));
	}

	.site-header.is-hidden {
		transform: translateY(-100%);
	}

	/* ---------- Top bar ---------- */
	/* Announcement strip with a slowly drifting brand gradient. */
	.topbar {
		height: var(--topbar-h);
		background: linear-gradient(100deg, #2db453, #16b39c 35%, #2db453 65%, #7fd35a);
		background-size: 220% 100%;
		animation: topbar-drift 14s ease-in-out infinite alternate;
		color: var(--ink);
		font-size: 0.875rem;
	}

	@keyframes topbar-drift {
		to {
			background-position: 100% 0;
		}
	}

	.topbar__inner {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		gap: 16px;
	}

	.topbar__text {
		display: flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.topbar__text :global(svg) {
		flex: none;
	}

	.topbar__label {
		font-weight: 600;
	}

	.topbar__cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		flex: none;
		height: 26px;
		padding: 0 10px;
		background: var(--ink);
		color: var(--white);
		font-size: 0.8125rem;
		font-weight: 550;
		border-radius: var(--r-xs);
		transition: background 0.3s;
	}

	.topbar__cta :global(svg) {
		transition: transform 0.35s var(--ease-out);
	}

	.topbar__cta:hover {
		background: var(--night-3);
	}

	.topbar__cta:hover :global(svg) {
		transform: translateX(3px);
	}

	@media (max-width: 639px) {
		.topbar__label,
		.topbar__cat {
			display: none;
		}
	}

	/* ---------- Main bar ---------- */
	.navbar {
		position: relative;
		height: var(--header-h);
		border-bottom: 1px solid transparent;
		transition:
			background 0.5s var(--ease-out),
			border-color 0.5s,
			backdrop-filter 0.5s;
	}

	.is-scrolled .navbar,
	.has-mega .navbar {
		background: rgba(245, 245, 245, 0.88);
		-webkit-backdrop-filter: saturate(1.6) blur(16px);
		backdrop-filter: saturate(1.6) blur(16px);
		border-bottom-color: var(--line);
	}

	.has-mega .navbar {
		background: var(--card);
	}

	/* Static so the mega panels position against .navbar, full width. */
	.navbar__inner {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: stretch;
		height: 100%;
		gap: 24px;
		position: static;
	}

	.brand {
		display: flex;
		align-items: center;
		justify-self: start;
	}

	.brand img {
		width: clamp(116px, 10vw, 136px);
		height: auto;
	}

	.nav {
		display: none;
	}

	@media (min-width: 1100px) {
		.navbar__inner {
			grid-template-columns: 1fr auto 1fr;
		}

		.nav {
			display: flex;
		}
	}

	.nav__list {
		display: flex;
		align-items: stretch;
		margin: 0;
		gap: 4px;
	}

	.nav__item {
		display: flex;
	}

	.nav__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 0 14px;
		font-size: 0.9375rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--ink-soft);
		transition: color 0.3s;
	}

	.nav__link::after {
		content: '';
		position: absolute;
		left: 14px;
		right: 14px;
		bottom: -1px;
		height: 2px;
		background: var(--green);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.5s var(--ease-out);
	}

	.nav__link:hover,
	.nav__link.is-active,
	.is-open > .nav__link {
		color: var(--ink);
	}

	.nav__link:hover::after,
	.nav__link.is-active::after,
	.is-open > .nav__link::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.nav__link :global(.nav__chev) {
		transition: transform 0.45s var(--ease-out);
		opacity: 0.6;
	}

	.is-open > .nav__link :global(.nav__chev) {
		transform: rotate(180deg);
	}

	.navbar__actions {
		display: flex;
		align-items: center;
		justify-self: end;
		gap: 10px;
	}

	.icon-btn {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border: 1px solid var(--line-2);
		border-radius: var(--r-xs);
		color: var(--ink);
		transition:
			background 0.35s,
			color 0.35s,
			border-color 0.35s;
	}

	.icon-btn:hover {
		background: #25d366;
		border-color: #25d366;
		color: var(--white);
	}

	@media (max-width: 639px) {
		.icon-btn,
		.navbar__actions :global(.navbar__cta) {
			display: none;
		}
	}

	.burger {
		position: relative;
		width: 42px;
		height: 42px;
		border-radius: var(--r-xs);
		background: var(--ink);
	}

	.burger span {
		position: absolute;
		left: 12px;
		right: 12px;
		height: 1.5px;
		background: var(--card);
		transition: transform 0.5s var(--ease-out);
	}

	.burger span:first-child {
		transform: translateY(-4px);
	}

	.burger span:last-child {
		transform: translateY(4px);
	}

	.burger[aria-expanded='true'] span:first-child {
		transform: rotate(45deg);
	}

	.burger[aria-expanded='true'] span:last-child {
		transform: rotate(-45deg);
	}

	@media (min-width: 1100px) {
		.burger {
			display: none;
		}
	}

	/* ---------- Mega menu ---------- */
	.mega {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: var(--card);
		border-bottom: 1px solid var(--line);
		box-shadow: 0 40px 80px -40px rgba(7, 16, 11, 0.25);
		clip-path: inset(0 0 100% 0);
		visibility: hidden;
		transition:
			clip-path 0.4s var(--ease-out),
			visibility 0s linear 0.4s;
	}

	.is-open > .mega {
		clip-path: inset(0 0 -80px 0);
		visibility: visible;
		transition:
			clip-path 0.5s var(--ease-out),
			visibility 0s;
	}

	/* Moving between open menus swaps panels without replaying the reveal. */
	.mega-switch .mega {
		transition: none;
	}

	.mega__inner {
		display: grid;
		gap: 32px;
		padding-block: 32px 36px;
	}

	.mega__inner > *,
	.mega li {
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.4s var(--ease-out),
			transform 0.6s var(--ease-out);
	}

	.is-open .mega__inner > *,
	.is-open .mega li {
		opacity: 1;
		transform: none;
		transition-delay: calc(80ms + var(--i, 0) * 35ms);
	}

	.mega__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 16px;
		margin-bottom: 8px;
		border-bottom: 1px solid var(--line);
		font-size: 0.875rem;
	}

	.mega__inner--services {
		grid-template-columns: 1fr 340px;
	}

	.mega-svcs {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin: 0;
	}

	.mega__title {
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.mega-svc {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			'name arrow'
			'sum sum';
		column-gap: 12px;
		row-gap: 4px;
		padding: 16px 16px 18px;
		border-radius: var(--r-sm);
		transition: background 0.35s;
	}

	.mega-svc__name {
		grid-area: name;
		font-weight: 550;
		letter-spacing: -0.015em;
	}

	.mega-svc__sum {
		grid-area: sum;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--muted);
	}

	.mega-svc :global(.mega-svc__arrow) {
		grid-area: arrow;
		color: var(--green-ink);
		opacity: 0;
		transform: translate(-6px, 6px);
		transition:
			opacity 0.35s,
			transform 0.5s var(--ease-out);
	}

	.mega-svc:hover,
	.mega-svc.is-current {
		background: var(--paper);
	}

	.mega-svc:hover :global(.mega-svc__arrow) {
		opacity: 1;
		transform: none;
	}

	.mega-card {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
		padding: 28px;
		border-radius: var(--r-sm);
		background: var(--night);
		color: var(--on-night-muted);
	}

	.mega-card .eyebrow {
		color: var(--on-night);
	}

	.mega-card__title {
		margin-top: auto;
		color: var(--on-night);
		font-size: 1.625rem;
		line-height: 1.1;
		letter-spacing: -0.035em;
	}

	.mega-card__text {
		font-size: 0.875rem;
		line-height: 1.55;
		margin-bottom: 6px;
	}

	.mega-card .aurora i {
		--o: 0.8;
	}

	.mega__inner--work .mega__head {
		margin-bottom: 0;
	}

	.mega-work {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
		margin: 0;
	}

	.mega-proj {
		display: grid;
		gap: 14px;
	}

	.mega-proj__img {
		aspect-ratio: 16 / 10;
	}

	.mega-proj__img img {
		object-position: top;
	}

	.mega-proj__cat {
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.mega-proj:hover img {
		transform: scale(1.06);
	}

	.mega-proj__meta {
		display: grid;
		gap: 2px;
	}

	.mega-proj__name {
		font-weight: 550;
		letter-spacing: -0.015em;
	}

	.mega__inner--company {
		grid-template-columns: 1fr 360px;
	}

	.mega-links {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0 24px;
		margin: 0;
	}

	.mega-link {
		display: grid;
		gap: 6px;

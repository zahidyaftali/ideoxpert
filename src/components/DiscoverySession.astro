---
// "Get a free plan for your website": the closing section of every page
// (added by BaseLayout). The form emails info@ideoxpert.com.
import { site, whatsappLink, contactPerson } from '../data/site';
import Icon from './Icon.astro';
import Person from './Person.astro';
import ProjectForm from './ProjectForm.astro';

interface Props {
	/** Service name to preselect in the form and mention on WhatsApp. */
	service?: string;
}

const { service } = Astro.props;
---
<section class="section discovery" id="discovery">
	<div class="container">
		<div class="frame brackets discovery__frame">
			<div class="discovery__intro">
				<div class="tex-layer discovery__tex" aria-hidden="true"></div>
				<h2 class="h2" data-split>Get a free plan for your website<span class="dot">.</span></h2>
				<p class="discovery__lead" data-reveal>Tell us what you are working on. We will tell you what is possible, what it costs and how long it takes. No pitch, just a straight answer.</p>
				<div class="dcards" data-reveal>
					<a class="dcard" href={`mailto:${site.email}`}>
						<span class="dcard__label"><Icon name="mail" size={16} /> Email us</span>
						<strong>{site.email}</strong>
					</a>
					<a class="dcard" href={whatsappLink(service)} target="_blank" rel="noopener">
						<span class="dcard__label"><Icon name="whatsapp" size={16} /> Call or WhatsApp</span>
						<strong>{site.phoneDisplay}</strong>
					</a>
				</div>
				<div class="discovery__person" data-reveal><Person person={contactPerson} line="who will plan and oversee your project." /></div>
				{site.calendarUrl && (
					<a class="link link--green" href={site.calendarUrl} target="_blank" rel="noopener" data-reveal>Prefer to pick a time? Book a 15-minute call <Icon name="arrow-right" /></a>
				)}
			</div>

			<ProjectForm id="discovery-form" form="discovery" service={service} class="discovery__form" />
		</div>
	</div>
</section>

<style>
	.discovery__frame {
		display: grid;
	}

	@media (min-width: 1024px) {
		.discovery__frame {
			grid-template-columns: 1fr 1fr;
		}

		:global(.discovery__form) {
			border-left: 1px solid var(--line);
		}
	}

	.discovery__intro {
		position: relative;
		isolation: isolate;
		display: grid;
		gap: 24px;
		align-content: start;
		padding: clamp(32px, 5vw, 72px);
		overflow: hidden;
	}

	.discovery__tex {
		background: url('/assets/images/textures/speckle.webp') left top / 700px auto;
		opacity: 0.35;
		-webkit-mask-image: radial-gradient(ellipse 80% 70% at 0% 0%, #000 10%, transparent 70%);
		mask-image: radial-gradient(ellipse 80% 70% at 0% 0%, #000 10%, transparent 70%);
	}

	.discovery__intro .h2 {
		max-width: 13ch;
	}

	.discovery__lead {
		max-width: 46ch;
		font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
		line-height: 1.6;
		color: var(--ink-soft);
	}

	.dcards {
		display: grid;
		gap: 12px;
		margin-top: 12px;
	}

	@media (min-width: 640px) {
		.dcards {
			grid-template-columns: 1fr 1fr;
		}
	}

	.dcard {
		display: grid;
		gap: 10px;
		padding: 20px;
		background: var(--paper-2);
		transition: background 0.3s;
	}

	.dcard:hover {
		background: var(--green-100);
	}

	.dcard__label {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.dcard strong {
		font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		overflow-wrap: anywhere;
	}

	:global(.discovery__form) {
		padding: clamp(28px, 4.5vw, 64px);
		border-top: 1px solid var(--line);
	}

	@media (min-width: 1024px) {
		:global(.discovery__form) {
			border-top: 0;
		}
	}
</style>

<script>
	import '../scripts/mail-form';
</script>

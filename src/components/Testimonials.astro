---
import { testimonials as all, type Testimonial } from '../data/testimonials';
import { projects } from '../data/projects';
import { stats, countries, site, founded } from '../data/site';
import Icon from './Icon.astro';

interface Props {
	items?: Testimonial[];
	eyebrow?: string;
	/** Rendered as HTML so a part can be bold. */
	title?: string;
}

// Each slide is a real project. Approved client quotes show as quotes;
// the rest show the project itself (see src/data/testimonials.ts).
const { items = all } = Astro.props;
const slides = items
	.map((t) => ({ t, p: projects.find((p) => p.id === t.project)! }))
	.filter(({ p }) => p)
	.map(({ t, p }) => ({
		...t,
		p,
		quoted: t.approved && !!t.quote && !!t.name,
		// "Jazba Host: web design and UK hosting..." -> "Web design and UK hosting..."
		line: p.headline.replace(/^[^:]+:\s*(.)/, (_, c: string) => c.toUpperCase()),
		country: countries.find((c) => c.code === p.country),
		logo: p.facts.logo?.marquee ? `/assets/images/work/${p.id}/logo-white.webp` : null,
	}));
const anyQuotes = slides.some((s) => s.quoted);
const {
	eyebrow = anyQuotes ? 'Real results from real clients' : 'Client stories',
	title = anyQuotes ? 'What clients say about working with us<span class="dot">.</span>' : 'Real clients, real websites<span class="dot">.</span>',
} = Astro.props;

const initials = (name: string) =>
	name
		.split(/\s+/)
		.map((p) => p[0])
		.slice(0, 2)
		.join('');
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="section section--dark grain testi" data-autotabs style="--dur: 8s">
	<div class="tex-layer tex-dots tex-fade" aria-hidden="true"></div>
	<div class="container testi__grid">
		<div class="testi__intro">
			<span class="eyebrow" data-reveal>{eyebrow}</span>
			<h2 class="h2" data-split set:html={title} />
			{/* A rating only with a real, public review page behind it (site.ts). */}
			{site.reviewUrl && site.rating ? (
				<a class="testi__score" href={site.reviewUrl} target="_blank" rel="noopener" data-reveal>
					<p class="testi__num"><span data-count={site.rating.value}>{site.rating.value}</span><span class="testi__of">/5</span></p>
					<div>
						<p class="testi__stars" aria-label={`Rated ${site.rating.value} out of 5`}>
							{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} />)}
						</p>
						<p class="testi__count">From {site.rating.count} public reviews</p>
					</div>
				</a>
			) : (
				<div class="testi__score" data-reveal>
					<p class="testi__num"><span data-count={stats.websites.value}>{stats.websites.value}</span><span class="testi__of">{stats.websites.suffix}</span></p>
					<p class="testi__count">Websites built since {founded},<br />for clients in {stats.countries.value} countries</p>
				</div>
			)}
		</div>

		<div class="testi__stage">
			<div class="testi__panels" data-pause-on-hover>
				{slides.map((s, i) => (
					<figure class:list={['testi__panel', { 'is-active': i === 0 }]} data-panel role="tabpanel" id={`testi-${i}`}>
						{s.quoted ? (
							<>
								<span class="testi__mark" aria-hidden="true">&ldquo;</span>
								<blockquote class="testi__quote"><p>{s.quote}</p></blockquote>
								<figcaption class="testi__who">
									{s.photo ? <img src={s.photo} alt="" width="48" height="48" loading="lazy" /> : <span class="testi__avatar" aria-hidden="true">{initials(s.name!)}</span>}
									<span>
										<strong>{s.name}</strong>
										<span>{s.role}</span>
										<span class="testi__rated" aria-label="Rated 5 out of 5">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={13} />)}</span>
									</span>
								</figcaption>
							</>
						) : (
							<>
								{s.logo ? <img class="testi__logo" src={s.logo} alt={s.p.name} height="36" loading="lazy" decoding="async" /> : <p class="testi__client">{s.p.name}</p>}
								<p class="testi__quote">{s.line}</p>
								<p class="testi__story">{s.p.brief}</p>
								<figcaption class="testi__who testi__who--project">
									{s.country && <img class="testi__flag" src={`/assets/images/flags/${s.country.code}.svg`} alt="" width="22" height="16" loading="lazy" />}
									<span><strong>{s.p.name}</strong><span>{s.p.industry}{s.country ? `, ${s.country.name}` : ''}</span></span>
									<a class="link link--green testi__case" href={`/work/${s.p.slug}`}>Read the case study <Icon name="arrow-right" /></a>
								</figcaption>
							</>
						)}
					</figure>
				))}
			</div>

			<div class="testi__controls">
				<div class="testi__tabs" role="tablist" aria-label="Testimonials">
					{slides.map((s, i) => (
						<button class:list={['testi__tab', { 'is-active': i === 0 }]} role="tab" data-tab aria-controls={`testi-${i}`} aria-label={s.p.name}>
							<span class="tab__bar"><i></i></span>
							<span class="index">{pad(i + 1)}</span>
						</button>
					))}
				</div>
				<div class="testi__arrows">
					<button type="button" data-tab-prev aria-label="Previous testimonial"><Icon name="arrow-left" size={18} /></button>
					<button type="button" data-tab-next aria-label="Next testimonial"><Icon name="arrow-right" size={18} /></button>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.testi__grid {
		display: grid;
		gap: 56px;
	}

	@media (min-width: 1024px) {
		.testi__grid {
			grid-template-columns: 0.9fr 1.1fr;
			gap: 96px;
		}
	}

	.testi__intro {
		display: grid;
		gap: 24px;
		align-content: start;
	}

	.testi__score {
		display: flex;
		align-items: center;
		gap: 20px;
		margin-top: 16px;
		padding-top: 28px;
		border-top: 1px solid var(--line);
	}

	.testi__num {
		font-size: clamp(3.5rem, 2rem + 4vw, 5.5rem);
		line-height: 0.9;
		letter-spacing: -0.06em;
		font-weight: 600;
		color: var(--on-night);
	}

	.testi__of {
		font-size: 0.4em;
		color: var(--on-night-muted);
		font-weight: 400;
		letter-spacing: -0.02em;
	}

	.testi__stars {
		display: flex;
		gap: 3px;
		color: var(--green);
		margin-bottom: 6px;
	}

	.testi__count {
		font-size: 0.9375rem;
	}

	.testi__stage {
		display: grid;
		gap: 40px;
		align-content: space-between;
	}

	.testi__panels {
		display: grid;
	}

	.testi__panel {
		grid-area: 1 / 1;
		display: grid;
		gap: 28px;
		align-content: start;
		opacity: 0;
		visibility: hidden;
		transform: translateY(18px);
		transition:
			opacity 0.5s var(--ease-out),
			transform 0.9s var(--ease-out),
			visibility 0s linear 0.5s;
	}

	.testi__panel.is-active {
		opacity: 1;
		visibility: visible;
		transform: none;
		transition:
			opacity 0.8s var(--ease-out) 0.15s,
			transform 1s var(--ease-out) 0.15s,
			visibility 0s;
	}

	.testi__mark {
		height: 0.42em;
		font-size: 6rem;
		line-height: 0.9;
		font-weight: 700;
		color: var(--green);
	}

	.testi__quote {
		font-size: clamp(1.375rem, 1.05rem + 1.1vw, 2.125rem);
		line-height: 1.3;
		letter-spacing: -0.028em;
		color: var(--on-night);
		text-wrap: pretty;
	}

	.testi__who {
		display: flex;
		align-items: center;
		gap: 14px;
		font-size: 0.9375rem;
	}

	.testi__who img,
	.testi__avatar {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		flex: none;
	}

	.testi__avatar {
		display: grid;
		place-items: center;
		background: var(--grad);
		color: var(--ink);
		font-weight: 600;
		font-size: 0.9375rem;
		letter-spacing: -0.02em;
	}

	.testi__logo {
		width: auto;
		max-width: 200px;
		height: 36px;
		object-fit: contain;
		object-position: left center;
		opacity: 0.9;
	}

	.testi__client {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--on-night);
	}

	.testi__story {
		max-width: 56ch;
		margin-top: -8px;
		font-size: 1rem;
		line-height: 1.65;
	}

	.testi__who--project {
		flex-wrap: wrap;
		padding-top: 22px;
		border-top: 1px solid var(--night-line);
	}

	.testi__who .testi__flag {
		width: 22px;
		height: 16px;
		object-fit: cover;
		border-radius: 2px;
		flex: none;
	}

	.testi__case {
		margin-left: auto;
		font-size: 0.9375rem;
	}

	.testi__rated {
		display: flex;
		gap: 2px;
		margin-top: 4px;
		color: var(--green);
	}

	.testi__who strong {
		display: block;
		color: var(--on-night);
		font-weight: 550;
	}

	.testi__controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.testi__tabs {
		display: flex;
		flex: 1;
		gap: 6px;
		max-width: 420px;
	}

	.testi__tab {
		position: relative;
		flex: 1;
		padding: 14px 0 0;
		text-align: left;
		color: var(--on-night-muted);
		transition: color 0.3s;
	}

	.testi__tab.is-active,
	.testi__tab:hover {
		color: var(--on-night);
	}

	.testi__tab .index {
		color: inherit;
	}

	.testi__arrows {
		display: flex;
		gap: 8px;
	}

	.testi__arrows button {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border: 1px solid var(--line-2);
		border-radius: 50%;
		color: var(--on-night);
		transition:
			background 0.35s,
			border-color 0.35s,
			color 0.35s;
	}

	.testi__arrows button:hover {
		background: var(--green);
		border-color: var(--green);
		color: var(--ink);
	}
</style>

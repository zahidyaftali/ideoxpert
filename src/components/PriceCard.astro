---
// One pricing card: the starting prices, hosting plans and care plans on
// /pricing. `price` and `sub` accept data-* attributes so the page script can
// redraw them in another currency or for annual billing.
import Icon from './Icon.astro';
import Button from './Button.astro';

interface Props {
	id?: string;
	title: string;
	/** Small line above the price, e.g. "from" or "usually". */
	pre?: string;
	price: string;
	priceAttrs?: Record<string, string | number>;
	unit?: string;
	desc?: string;
	/** Line under the price, e.g. the yearly total. */
	sub?: string;
	subAttrs?: Record<string, string | number>;
	features?: string[];
	/** Extra features behind "Show all features" (only when not empty). */
	more?: string[];
	/** A text link, or a full button when `button` is true (plan cards). */
	cta?: { label: string; href: string; button?: boolean; attrs?: Record<string, string> };
	badge?: string;
	/** The highlighted card: the site's dark panel. */
	dark?: boolean;
}

const { id, title, pre, price, priceAttrs = {}, unit, desc, sub, subAttrs = {}, features = [], more = [], cta, badge, dark = false } = Astro.props;
---
<article class:list={['pcard2', { 'pcard2--dark grain grain--dark': dark }]} id={id}>
	<header class="pcard2__head">
		<h3 class="pcard2__title">{title}</h3>
		{badge && <span class="pcard2__badge">{badge}</span>}
	</header>
	<p class="pcard2__price">
		{pre && <span class="pcard2__pre">{pre}</span>}
		<span class="pcard2__amount" {...priceAttrs}>{price}</span>
		{unit && <span class="pcard2__unit">{unit}</span>}
	</p>
	{sub && <p class="pcard2__sub" {...subAttrs}>{sub}</p>}
	{desc && <p class="pcard2__desc">{desc}</p>}
	{features.length > 0 && (
		<ul class="pcard2__list" role="list">
			{features.map((f) => <li><Icon name="check" size={16} /> {f}</li>)}
		</ul>
	)}
	{more.length > 0 && (
		<details class="pcard2__more">
			<summary>Show all features</summary>
			<ul class="pcard2__list" role="list">
				{more.map((f) => <li><Icon name="check" size={16} /> {f}</li>)}
			</ul>
		</details>
	)}
	{cta && cta.button && (
		<div class="pcard2__cta"><Button href={cta.href} variant={dark ? 'primary' : 'dark'} size="sm" {...(cta.attrs ?? {})}>{cta.label}</Button></div>
	)}
	{cta && !cta.button && (
		<a class="pcard2__cta link link--green" href={cta.href} {...(cta.attrs ?? {})}>{cta.label} <Icon name="arrow-right" size={16} /></a>
	)}
</article>

<style>
	.pcard2 {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 14px;
		height: 100%;
		padding: clamp(22px, 2.4vw, 32px);
		background: var(--card);
		border: 1px solid var(--line);
	}

	.pcard2--dark {
		background: var(--night);
		border-color: var(--night);
		color: var(--on-night-muted);
	}

	.pcard2__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.pcard2__title {
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.pcard2--dark .pcard2__title {
		color: var(--on-night);
	}

	.pcard2__badge {
		padding: 5px 10px;
		background: var(--green);
		color: var(--ink);
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.pcard2__price {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 6px;
		margin: 0;
	}

	.pcard2__pre {
		font-size: 0.9375rem;
		color: var(--muted);
	}

	.pcard2--dark .pcard2__pre,
	.pcard2--dark .pcard2__unit {
		color: var(--on-night-muted);
	}

	.pcard2__amount {
		font-size: clamp(2rem, 1.5rem + 1.4vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1;
		color: var(--ink);
	}

	.pcard2--dark .pcard2__amount {
		color: var(--on-night);
	}

	.pcard2__unit {
		font-size: 0.9375rem;
		color: var(--muted);
	}

	.pcard2__sub {
		font-size: 0.875rem;
		color: var(--muted);
	}

	.pcard2--dark .pcard2__sub {
		color: var(--on-night-muted);
	}

	.pcard2__desc {
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ink-soft);
	}

	.pcard2--dark .pcard2__desc {
		color: var(--on-night-muted);
	}

	.pcard2__list {
		display: grid;
		gap: 8px;
		margin: 4px 0 0;
		padding-top: 16px;
		border-top: 1px solid var(--line);
		font-size: 0.9375rem;
	}

	.pcard2--dark .pcard2__list {
		border-color: var(--night-line);
	}

	.pcard2__list li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
	}

	.pcard2__list :global(svg) {
		margin-top: 3px;
		color: var(--green);
	}

	.pcard2__more summary {
		cursor: pointer;
		font-size: 0.875rem;
		font-weight: 550;
	}

	.pcard2__cta {
		margin-top: auto;
		align-self: flex-start;
	}

	a.pcard2__cta.link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding-top: 8px;
		font-weight: 550;
	}
</style>

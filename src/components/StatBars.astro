---
// Four stepped bars that grow up from the baseline as they scroll into view.
import { stats, countries } from '../data/site';
import { projects } from '../data/projects';

const bars = [
	{ value: `${stats.years.value}+`, label: 'Years of experience' },
	{ value: `${stats.rating.value}★`, label: 'Average client rating' },
	{ value: `${countries.length}`, label: 'Countries we work in' },
	{ value: `${projects.length}+`, label: 'Websites live' },
];
---
<section class="section bars-section">
	<div class="container">
		<div class="bars" data-bars>
			{bars.map((b, i) => (
				<div class="bar" style={`--i:${i}`}>
					<div class="bar__fill">
						<span class="bar__value">{b.value}</span>
						<span class="bar__label">{b.label}</span>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.bars {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		align-items: end;
		height: clamp(360px, 40vw, 600px);
	}

	.bar {
		height: calc(40% + var(--i) * 20%);
		display: flex;
	}

	.bar__fill {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		width: 100%;
		padding: clamp(18px, 2.2vw, 32px);
		background: color-mix(in srgb, #2db453 calc(100% - var(--i) * 18%), #16805a);
		overflow: hidden;
		transform-origin: 50% 100%;
		transition: transform 1s var(--ease-out);
		transition-delay: calc(var(--i) * 120ms);
	}

	/* Fine dot texture towards the bottom right of each bar. */
	.bar__fill::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: radial-gradient(rgba(13, 18, 16, 0.18) 1px, transparent 1.3px);
		background-size: 7px 7px;
		-webkit-mask-image: radial-gradient(ellipse 80% 70% at 90% 100%, #000 10%, transparent 70%);
		mask-image: radial-gradient(ellipse 80% 70% at 90% 100%, #000 10%, transparent 70%);
	}

	:global(.js) .bars:not(.is-in) .bar__fill {
		transform: scaleY(0);
	}

	.bar__value {
		font-size: clamp(2.25rem, 1.2rem + 3.4vw, 4.75rem);
		line-height: 1;
		letter-spacing: -0.05em;
		font-weight: 650;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.bar__label {
		font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 1rem);
		font-weight: 550;
		color: var(--ink);
	}

	@media (max-width: 699px) {
		.bars {
			grid-template-columns: repeat(2, 1fr);
			height: auto;
			gap: 0;
		}

		.bar {
			height: calc(160px + var(--i) * 36px);
			align-self: end;
		}
	}
</style>

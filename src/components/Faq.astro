---
import type { Faq } from '../data/faqs';
import { site, whatsappLink } from '../data/site';
import Icon from './Icon.astro';

interface Props {
	items: Faq[];
	title?: string;
	id?: string;
	/** Mono label above the title. */
	kicker?: string;
	/** One bordered frame with the list on the right, like the reference's "What's the catch?". */
	framed?: boolean;
}

const { items, title = 'Common questions, honest answers<span class="dot">.</span>', id = 'faq', kicker, framed = false } = Astro.props;
---
<section class:list={['section faq', { 'faq--framed': framed }]} id={id}>
	<div class="container">
	<div class:list={['faq__grid', { brackets: framed }]}>
		<div class="faq__side">
			{kicker && <p class="kicker" data-reveal>{kicker}</p>}
			<h2 class="h2" data-split set:html={title} />
			<div class="faq__ask" data-reveal>
				<p>Still have a question? Ask us directly. We reply {site.replyTime}.</p>
				<a class="link link--green" href={whatsappLink()} target="_blank" rel="noopener">Message us on WhatsApp <Icon name="arrow-right" /></a>
			</div>
			{framed && <div class="faq__tex tex-dots" aria-hidden="true"></div>}
		</div>

		<div class="faq__list" data-acc-single data-reveal-group="70">
			{items.map((f) => (
				<details class="acc" data-reveal>
					<summary>
						<span class="acc__q">{f.q}</span>
						<span class="acc__icon" aria-hidden="true"></span>
					</summary>
					<div class="acc__body">{f.html ? <p set:html={f.html} /> : <p>{f.a}</p>}</div>
				</details>
			))}
		</div>
	</div>
	</div>
</section>

<style>
	.faq__grid {
		display: grid;
		gap: 48px;
	}

	@media (min-width: 1024px) {
		.faq__grid {
			grid-template-columns: 0.85fr 1.15fr;
			gap: 96px;
		}

		.faq__side {
			position: sticky;
			top: 120px;
			align-self: start;
		}
	}

	.faq__side {
		display: grid;
		gap: 24px;
	}

	.faq__ask {
		display: grid;
		gap: 12px;
		margin-top: 16px;
		padding: 24px;
		background: var(--card);
		color: var(--muted);
		font-size: 0.9375rem;
		justify-items: start;
	}

	.faq__list {
		border-top: 1px solid var(--line-2);
	}

	.acc {
		border-bottom: 1px solid var(--line-2);
	}

	.acc summary {
		display: grid;
		grid-template-columns: 1fr 28px;
		align-items: start;
		gap: 12px;
		padding: 26px 0;
		cursor: pointer;
		list-style: none;
	}

	.acc summary::-webkit-details-marker {
		display: none;
	}

	.acc__q {
		font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
		letter-spacing: -0.025em;
		line-height: 1.35;
		font-weight: 500;
		transition: color 0.3s;
	}

	.acc summary:hover .acc__q {
		color: var(--green-ink);
	}

	/* Plus that turns into a minus. */
	.acc__icon {
		position: relative;
		width: 28px;
		height: 28px;
		border: 1px solid var(--line-2);
		border-radius: 50%;
		transition:
			background 0.4s,
			border-color 0.4s;
	}

	.acc__icon::before,
	.acc__icon::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		width: 10px;
		height: 1.5px;
		margin: -0.75px 0 0 -5px;
		background: currentColor;
		transition: transform 0.5s var(--ease-out);
	}

	.acc__icon::after {
		transform: rotate(90deg);
	}

	.acc.is-open .acc__icon,
	.acc[open]:not(.is-open) .acc__icon {
		background: var(--green);
		border-color: var(--green);
	}

	.acc.is-open .acc__icon::after {
		transform: rotate(0deg);
	}

	.acc__body {
		overflow: hidden;
	}

	/* ---------- Framed variant ---------- */
	.faq--framed .faq__grid {
		gap: 0;
		border: 1px solid var(--line);
	}

	.faq--framed .faq__side {
		position: relative;
		isolation: isolate;
		align-content: start;
		gap: 18px;
		padding: clamp(24px, 3.6vw, 52px);
		overflow: hidden;
	}

	.faq--framed .faq__list {
		border-top: 1px solid var(--line);
	}

	@media (min-width: 1024px) {
		.faq--framed .faq__grid {
			grid-template-columns: 1fr 1fr;
			gap: 0;
		}

		.faq--framed .faq__side {
			position: relative;
			top: auto;
			align-self: stretch;
		}

		.faq--framed .faq__list {
			border-top: 0;
			border-left: 1px solid var(--line);
		}
	}

	.faq--framed .faq__ask {
		background: transparent;
		padding: 0;
	}

	.faq--framed .faq__tex {
		position: absolute;
		left: 10%;
		right: 10%;
		bottom: 8%;
		z-index: -1;
		height: 45%;
		opacity: 0.55;
		-webkit-mask-image: radial-gradient(ellipse at 50% 50%, #000 10%, transparent 68%);
		mask-image: radial-gradient(ellipse at 50% 50%, #000 10%, transparent 68%);
	}

	.faq--framed .acc {
		border-bottom: 1px solid var(--line);
	}

	.faq--framed .acc:last-child {
		border-bottom: 0;
	}

	.faq--framed .acc summary {
		padding: 24px clamp(20px, 2.4vw, 32px);
	}

	.faq--framed .acc__body p {
		padding: 0 clamp(20px, 2.4vw, 32px) 26px;
	}

	.acc__body p {
		padding: 0 48px 28px 0;
		color: var(--muted);
		max-width: 68ch;
	}
</style>

---
// /pricing: starting prices, what's included, hosting and care plans, how
// payment works. Every number comes from src/data/pricing.ts. Each section
// follows a section of the reference site (codedistrict.com): bracketed
// cell grids, mono tags and [n] numbers, numbered rows, and a dark panel.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { site, services } from '../data/site';
import { faqSchema } from '../data/faqs';
import { alwaysIncluded, care, currencyList, from, hosting, money, notIncluded, policies, pricingFaqs, seo, store, website } from '../data/pricing';

const usd = (n: number) => money(n, 'USD');
const weeks = (w: [number, number]) => (w[0] === w[1] ? `${w[0]} weeks` : `${w[0]}–${w[1]} weeks`);
const siteWeeks = website.pages.find((p) => p.id === '2-5')!.weeks;
const storeWeeks = store.products[0].weeks;
const calc = '/website-cost-calculator';
const n = (i: number) => `[${i + 1}]`;

// Starting prices: one cell each. `attrs` let the page script redraw the price in GBP or EUR.
const starts = [
	{ id: 'website', tag: 'One-off', title: 'Business website', pre: 'from', price: usd(from.website), attrs: { 'data-usd': from.website, 'data-kind': 'oneoff' }, desc: `A ${from.websitePages}-page website for your business, built so you can edit it yourself. Ready in ${weeks(siteWeeks)}.`, cta: 'Estimate my website', href: `${calc}?need=website` },
	{ id: 'store', tag: 'One-off', title: 'Online store', pre: 'from', price: usd(from.store), attrs: { 'data-usd': from.store, 'data-kind': 'oneoff' }, desc: `WooCommerce or Shopify with up to ${from.storeProducts} products and card payments set up and tested. Ready in ${weeks(storeWeeks)}.`, cta: 'Estimate my store', href: `${calc}?need=store` },
	{ id: 'seo', tag: 'Monthly', title: 'Local SEO', pre: 'from', price: usd(from.seo), unit: '/month', attrs: { 'data-usd': from.seo, 'data-kind': 'monthly' }, desc: `Get found in your town: technical fixes, local pages and your Google Business Profile. Minimum ${seo.minimumMonths} months.`, cta: 'Estimate my SEO', href: `${calc}?need=seo` },
	{ id: 'hosting', tag: 'Monthly', title: 'Hosting', pre: 'from', price: usd(from.hosting), unit: '/month', attrs: { 'data-host-min': '' }, desc: 'Fast, managed hosting with SSL, daily backups and email accounts.', cta: 'See hosting plans', href: '#hosting-plans' },
	{ id: 'care', tag: 'Monthly', title: 'Website care', pre: 'from', price: usd(from.care), unit: '/month', attrs: { 'data-usd': from.care, 'data-kind': 'monthly' }, desc: 'We keep your site updated, secure and backed up, and fix it if something breaks.', cta: 'See care plans', href: '#care-plans' },
	{ id: 'apps', tag: 'Quoted', title: 'Mobile and web apps', pre: 'usually', price: `${usd(from.app[0])}–${usd(from.app[1])}`, attrs: { 'data-usd-range': `${from.app[0]}-${from.app[1]}` }, range: true, desc: 'Every app is different, so we quote each one. Tell us your idea and we’ll send a fixed quote within 48 hours.', cta: 'Talk about my app', href: '#discovery' },
];

// Care plans: the green line under each button.
const careNote: Record<string, string> = {
	care: 'Our hosting or yours · cancel any time',
	plus: 'Includes 2 hours of changes a month · cancel any time',
};

const payment = [
	{ title: 'Fixed quote', text: 'You tell us what you need. We send a fixed price and a timeline within 24 hours.' },
	{ title: '50% to start', text: 'You pay half to book your project. We start within a few days.' },
	{ title: 'Design, build, review', text: 'You see the design before we build it. Two rounds of changes are included.' },
	{ title: '50% at launch', text: 'You pay the rest when you’ve approved the finished site, before it goes live.' },
];

const why = [
	{ icon: 'pin', title: 'Lower costs in Islamabad', text: 'Offices, salaries and everyday costs are lower here, so we can charge less for the same work.' },
	{ icon: 'globe', title: 'The same standard', text: 'Open the live websites we’ve built for businesses in the UK, Germany, the Netherlands, Australia, Canada and the US.' },
	{ icon: 'users', title: 'You talk to the people building it', text: 'No account managers, no outsourcing, no one passing your project along.' },
] as const;

const url = (path: string) => `${site.url}${path}`;
const schema = [
	{
		'@type': 'OfferCatalog',
		name: 'IdeoXpert prices',
		url: url('/pricing'),
		itemListElement: [
			{ '@type': 'Offer', name: 'Business website', url: url('/website-development'), priceSpecification: { '@type': 'PriceSpecification', minPrice: from.website, priceCurrency: 'USD' } },
			{ '@type': 'Offer', name: 'Online store', url: url('/ecommerce-development'), priceSpecification: { '@type': 'PriceSpecification', minPrice: from.store, priceCurrency: 'USD' } },
			{ '@type': 'Offer', name: 'Local SEO', url: url('/seo-optimization'), priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: from.seo, priceCurrency: 'USD', unitCode: 'MON' } },
			{ '@type': 'Offer', name: 'Mobile and web apps', url: url('/mobile-app-development'), priceSpecification: { '@type': 'PriceSpecification', minPrice: from.app[0], maxPrice: from.app[1], priceCurrency: 'USD' } },
			...hosting.plans.map((p) => ({
				'@type': 'Offer',
				name: `${p.name} hosting`,
				url: url('/hosting-domain'),
				price: p.monthly.USD,
				priceCurrency: 'USD',
				priceSpecification: { '@type': 'UnitPriceSpecification', price: p.monthly.USD, priceCurrency: 'USD', unitCode: 'MON' },
			})),
			...care.plans.map((p) => ({
				'@type': 'Offer',
				name: `${p.name} website care`,
				url: url('/website-maintenance'),
				price: p.monthly,
				priceCurrency: 'USD',
				priceSpecification: { '@type': 'UnitPriceSpecification', price: p.monthly, priceCurrency: 'USD', unitCode: 'MON' },
			})),
		],
	},
	faqSchema(pricingFaqs),
];
---
<BaseLayout
	title="Website Pricing & Hosting Plans | IdeoXpert"
	description={`Clear prices for websites, online stores, SEO and hosting. Business websites from ${usd(from.website)}, hosting from ${usd(from.hosting)} a month. Fixed quote within 24 hours.`}
	keywords="website design pricing, web design prices, small business website cost, WordPress website price, website hosting plans, ecommerce website price"
	breadcrumbs={[{ name: 'Pricing', path: '/pricing' }]}
	schema={schema}
>
	<PageHero
		crumbs={[{ name: 'Pricing', path: '/pricing' }]}
		title="Clear prices. <b>No surprises</b>"
		lead="Most agencies want a call before they’ll talk about money. We’d rather show you. Here are our starting prices, what’s included, and how payment works. Want a number for your own project? The calculator gives you one in about a minute."
	>
		<Fragment slot="actions">
			<Button href={calc} variant="primary" magnetic>Estimate my project</Button>
			<Button href="#discovery" variant="ghost" icon={false}>Get a fixed quote</Button>
		</Fragment>
		<p class="pr-note" data-reveal style="--d:400">Fixed quote within 24 hours. No obligation.</p>
		<div slot="aside" class="pr-snap" data-reveal="fade" style="--d:200">
			<p class="pr-snap__label"><span class="tag">At a glance</span> Website design pricing</p>
			<dl class="pr-snap__list">
				<div><dt>Business website</dt><dd>from <span data-usd={from.website} data-kind="oneoff">{usd(from.website)}</span></dd></div>
				<div><dt>Online store</dt><dd>from <span data-usd={from.store} data-kind="oneoff">{usd(from.store)}</span></dd></div>
				<div><dt>Local SEO</dt><dd>from <span data-usd={from.seo} data-kind="monthly">{usd(from.seo)}</span>/month</dd></div>
				<div><dt>Hosting</dt><dd>from <span data-host-min>{usd(from.hosting)}</span>/month</dd></div>
				<div><dt>Website care</dt><dd>from <span data-usd={from.care} data-kind="monthly">{usd(from.care)}</span>/month</dd></div>
			</dl>
		</div>
	</PageHero>

	<!-- Starting prices (reference: bracketed grid of cells with a tag and [n]) -->
	<section class="section pr-start" id="prices">
		<div class="container">
			<div class="pr-top">
				<div class="pr-top__main">
					<p class="kicker" data-reveal>Starting prices, in your currency_</p>
					<h2 class="h2" data-split>Where <b>prices start</b></h2>
				</div>
				<div class="pr-top__side">
					<p data-reveal>Small business website costs, from a landing page to an online store. Every price is a starting point; your fixed quote depends on what you need.</p>
					<div class="segment" role="group" aria-label="Currency" data-reveal>
						{currencyList.map((c) => <button type="button" data-cur={c} aria-pressed={c === 'USD' ? 'true' : 'false'}>{c}</button>)}
					</div>
				</div>
			</div>
			<ul class="pr-cells brackets" role="list" data-reveal-group="60">
				{starts.map((c, i) => (
					<li class="pr-cell" id={c.id} data-reveal>
						<div class="pr-cell__top"><span class="tag tag--soft">{c.tag}</span><span class="pr-num">{n(i)}</span></div>
						<h3 class="pr-cell__title">{c.title}</h3>
						<p class="pr-cell__price">
							<span class="pr-cell__pre">{c.pre}</span>
							<span class:list={['pr-cell__amount', { 'pr-cell__amount--range': c.range }]} {...c.attrs}>{c.price}</span>
							{c.unit && <span class="pr-cell__unit">{c.unit}</span>}
						</p>
						<p class="pr-cell__desc">{c.desc}</p>
						<a class="pr-cell__cta link link--green" href={c.href}>{c.cta} <Icon name="arrow-right" size={16} /></a>
					</li>
				))}
			</ul>
			<p class="pr-services" data-reveal>
				More about each service:
				{services.map((s, i) => (
					<>
						<a href={`/${s.slug}`}>{s.name}</a>{i < services.length - 1 ? ', ' : '.'}
					</>
				))}
			</p>
		</div>
	</section>

	<!-- Included (reference: "Two ways to start", two columns in one frame) -->
	<section class="section pr-inc">
		<div class="container">
			<div class="pr-center">
				<h2 class="h2" data-split>What’s <b>always included</b></h2>
				<p class="subtitle" data-reveal>What every website comes with, and what costs extra, so there are no surprises later.</p>
			</div>
			<div class="pr-two brackets">
				<div class="pr-two__col" data-reveal>
					<div class="pr-two__top"><span class="pr-two__label"><Icon name="check" size={20} /> Included_</span><span class="pr-num">[1]</span></div>
					<p class="pr-two__big">In every website we build.</p>
					<ul class="pr-list" role="list">
						{alwaysIncluded.map((i) => <li>{i}</li>)}
					</ul>
					<div class="pr-two__tex tex-dots" aria-hidden="true"></div>
				</div>
				<div class="pr-two__col" data-reveal style="--d:120">
					<div class="pr-two__top"><span class="pr-two__label pr-two__label--muted"><Icon name="close" size={18} /> Not included_</span><span class="pr-num">[2]</span></div>
					<p class="pr-two__big">Paid separately, only if your site needs them.</p>
					<ul class="pr-list" role="list">
						{notIncluded.map((i) => <li>{i}</li>)}
					</ul>
					<div class="pr-two__tex tex-dots" aria-hidden="true"></div>
				</div>
			</div>
		</div>
	</section>

	<!-- Hosting plans (reference: offer grid with solid tags and a panel at the foot) -->
	<section class="section pr-host" id="hosting-plans">
		<div class="container">
			<div class="pr-top">
				<div class="pr-top__main">
					<p class="kicker" data-reveal>Hosting plans, billed monthly or yearly_</p>
					<h2 class="h2" data-split>Hosting that’s <b>looked after</b></h2>
				</div>
				<div class="pr-top__side">
					<p data-reveal>Your website needs a home. Ours is fast, backed up every day, and managed by the same team that built your site, so when something needs fixing, you talk to the people who know it.</p>
					<div class="pr-toggles" data-reveal>
						<div class="segment" role="group" aria-label="Billing">
							<button type="button" data-billing="monthly" aria-pressed="true">Monthly</button>
							<button type="button" data-billing="annual" aria-pressed="false">Annual: save {hosting.annualSaving}%</button>
						</div>
						<div class="segment" role="group" aria-label="Currency">
							{currencyList.map((c) => <button type="button" data-cur={c} aria-pressed={c === 'USD' ? 'true' : 'false'}>{c}</button>)}
						</div>
					</div>
				</div>
			</div>
			<ul class="pr-cells pr-cells--plans brackets" role="list" data-reveal-group="80">
				{hosting.plans.map((p) => (
					<li class="pr-plan" data-reveal>
						<span class="tag">{p.tag}</span>
						<h3 class="pr-plan__name">{p.name}</h3>
						<p class="pr-plan__line">{p.desc}</p>
						<ul class="pr-list" role="list">
							{p.features.map((f) => <li>{f}</li>)}
						</ul>
						{p.more.length > 0 && (
							<details class="pr-plan__more">
								<summary>Show all features</summary>
								<ul class="pr-list" role="list">
									{p.more.map((f) => <li>{f}</li>)}
								</ul>
							</details>
						)}
						<div class:list={['pr-plan__card', { 'pr-plan__card--dark section--dark': p.popular }]}>
							<div class="pr-plan__cardtop">
								<span>{p.name} hosting</span>
								<span class="tag tag--soft" data-annual-only hidden>Save {hosting.annualSaving}%</span>
							</div>
							<p class="pr-plan__price"><span data-host-price={p.id}>{usd(p.monthly.USD)}</span><span class="pr-plan__unit">/month</span></p>
							<p class="pr-plan__sub" data-host-sub={p.id}>{`${usd(Math.round(p.monthly.USD * 12 * 100) / 100)} a year billed monthly · switch to annual and pay ${usd(p.annualPerYear.USD)}`}</p>
							<Button href="#discovery" variant={p.popular ? 'primary' : 'dark'} size="sm" data-plan={p.name}>{`Choose ${p.name}`}</Button>
						</div>
					</li>
				))}
			</ul>
			<p class="pr-small" data-reveal>Domain registration or transfer is at cost, usually about {usd(hosting.domainPerYear)} a year, and is not part of the plans. {policies.taxes} Annual plans are billed once a year.</p>
		</div>
	</section>

	<!-- Care plans (reference: "Two ways to start", full width) -->
	<section class="section pr-care" id="care-plans">
		<div class="container">
			<div class="pr-center">
				<h2 class="h2" data-split>Care plans, so <b>nothing breaks</b></h2>
				<p class="subtitle" data-reveal>Websites need updates, like any software. Skip them and things break or get hacked. Our care plans handle it for you, on our hosting or yours.</p>
			</div>
			<div class="pr-two brackets">
				{care.plans.map((p, i) => (
					<article class="pr-two__col pr-carep" data-reveal style={`--d:${i * 120}`}>
						<div class="pr-two__top"><span class="pr-two__label"><Icon name={i ? 'star' : 'spark'} size={20} /> {p.name}_</span><span class="pr-num">{n(i)}</span></div>
						<p class="pr-carep__price"><span data-usd={p.monthly} data-kind="monthly">{usd(p.monthly)}</span><span class="pr-carep__unit">/month</span></p>
						<p class="pr-carep__desc">{p.desc}</p>
						<ul class="pr-list pr-list--cols" role="list">
							{p.features.map((f) => <li>{f}</li>)}
						</ul>
						<div class="pr-carep__foot">
							<Button href="#discovery" size="sm" data-care={p.name}>{`Choose ${p.name}`}</Button>
							<p class="pr-carep__note">{careNote[p.id]}</p>
						</div>
						<div class="pr-two__tex tex-dots" aria-hidden="true"></div>
					</article>
				))}
			</div>
			<p class="pr-small pr-small--center" data-reveal>{care.note} {policies.cancel}</p>
		</div>
	</section>

	<!-- How payment works (reference: "How does this work?", numbered rows) -->
	<section class="section pr-pay">
		<div class="container">
			<div class="pr-center">
				<h2 class="h2" data-split>How <b>payment works</b></h2>
			</div>
			<ol class="pr-rows" role="list">
				{payment.map((s, i) => (
					<li class="pr-row" data-reveal>
						<span class="pr-row__n">[{String(i + 1).padStart(2, '0')}]</span>
						<h3 class="pr-row__t">{s.title}<span class="pr-row__cursor" aria-hidden="true">_</span></h3>
						<p class="pr-row__p">{s.text}</p>
					</li>
				))}
			</ol>
			<p class="pr-pay__note" data-reveal>{policies.invoices} You own your domain, website and content from day one. Extra work is {usd(policies.hourlyRate)} an hour, always agreed with you before we start.</p>
		</div>
	</section>

	<!-- Why lower (reference: dark panel on the left, reasons on the right) -->
	<section class="section pr-why">
		<div class="container">
			<div class="pr-why__frame brackets">
				<div class="pr-why__dark section--dark grain grain--dark">
					<p class="pr-why__chip" data-reveal><span class="pr-why__live" aria-hidden="true"></span> Based in Islamabad, Pakistan_</p>
					<h2 class="h2" data-split>Why we cost <b>less than local agencies</b></h2>
					<div class="pr-why__btns" data-reveal>
						<Button href="/portfolio" variant="primary">See our work</Button>
						<Button href={calc} variant="ghost-light" icon={false}>Estimate my project</Button>
					</div>
					<div class="pr-why__tex tex-dots" aria-hidden="true"></div>
				</div>
				<ul class="pr-why__list" role="list">
					{why.map((w) => (
						<li data-reveal>
							<Icon name={w.icon} size={26} />
							<h3>{w.title}</h3>
							<p>{w.text}</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<Faq items={pricingFaqs} title="Pricing <b>questions</b>" id="pricing-faq" kicker="Still not sure? The questions people ask_" framed />
</BaseLayout>

<script>
	import '../scripts/pricing-page';
</script>

<style>
	.pr-note {
		font-size: 0.875rem;
		color: var(--muted);
	}

	/* Hero side: prices at a glance */
	.pr-snap {
		display: grid;
		gap: 16px;
		width: min(100%, 420px);
		padding: clamp(22px, 3vw, 36px);
		background: var(--card);
		border: 1px solid var(--line);
	}

	.pr-snap__label {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		font-size: 0.875rem;
		font-weight: 550;
		color: var(--ink-soft);
	}

	.pr-snap__list {
		display: grid;
		margin: 0;
	}

	.pr-snap__list div {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 0;
		border-top: 1px solid var(--line);
	}

	.pr-snap__list dt {
		font-weight: 550;
		color: var(--ink);
	}

	.pr-snap__list dd {
		margin: 0;
		color: var(--ink-soft);
		white-space: nowrap;
	}

	/* ---------- Shared pieces ---------- */

	/* Section head like the reference: kicker and heading on the left, the
	   intro (and any switches) on the right, aligned to the bottom. */
	.pr-top {
		display: grid;
		gap: 20px 64px;
		margin-bottom: clamp(32px, 4vw, 56px);
	}

	@media (min-width: 1024px) {
		.pr-top {
			grid-template-columns: 1.1fr 1fr;
			align-items: end;
		}
	}

	.pr-top__main {
		display: grid;
		gap: 16px;
	}

	.pr-top__side {
		display: grid;
		gap: 20px;
		justify-items: start;
		color: var(--ink-soft);
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.pr-top__side p {
		max-width: 56ch;
	}

	/* Centered head, like "Two ways to start" and "How does this work?". */
	.pr-center {
		display: grid;
		justify-items: center;
		gap: 16px;
		max-width: 760px;
		margin: 0 auto clamp(36px, 4.5vw, 64px);
		text-align: center;
	}

	.pr-num {
		font-family: var(--mono);
		font-size: 0.875rem;
		color: var(--muted-2);
	}

	/* Bullets drawn as small corner marks (the reference's └). */
	.pr-list {
		display: grid;
		gap: 12px;
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.pr-list li {
		position: relative;
		padding-left: 24px;
	}

	.pr-list li::before {
		content: '';
		position: absolute;
		left: 3px;
		top: 0.3em;
		width: 8px;
		height: 8px;
		border-left: 1.5px solid var(--muted-2);
		border-bottom: 1.5px solid var(--muted-2);
	}

	.segment {
		display: inline-flex;
		border: 1px solid var(--line-2);
		background: var(--card);
	}

	.segment button {
		padding: 10px 16px;
		font-size: 0.875rem;
		font-weight: 550;
		color: var(--muted);
		transition:
			background 0.25s,
			color 0.25s;
	}

	.segment button + button {
		border-left: 1px solid var(--line-2);
	}

	.segment button:hover {
		color: var(--ink);
	}

	.segment button[aria-pressed='true'] {
		background: var(--ink);
		color: #fff;
	}

	.segment button:focus-visible {
		outline: 2px solid var(--green);
		outline-offset: 2px;
	}

	.pr-toggles {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.pr-small {
		margin-top: 20px;
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.pr-small--center {
		text-align: center;
	}

	.pr-services {
		margin-top: 24px;
		font-size: 0.9375rem;
		color: var(--muted);
	}

	.pr-services a {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* ---------- Cell grid: one frame, cells split by hairlines ---------- */
	.pr-cells {
		display: grid;
		gap: 1px;
		margin: 0;
		background: var(--line);
		border: 1px solid var(--line);
	}

	@media (min-width: 700px) {
		.pr-cells {
			grid-template-columns: repeat(2, 1fr);
		}

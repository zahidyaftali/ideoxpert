---
// Country page (/locations/<slug>): framed hero with the country's main
// cities, local client work, why businesses there work with us, services and
// a country-specific FAQ.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import WorkStack from '../../components/WorkStack.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import WhatWeBuild from '../../components/WhatWeBuild.astro';
import Faq from '../../components/Faq.astro';
import { locations, type Location } from '../../data/locations';
import { projects, recentProjects } from '../../data/projects';
import { site } from '../../data/site';
import { faqSchema } from '../../data/faqs';

export const getStaticPaths = (() => locations.map((location) => ({ params: { slug: location.slug }, props: { location } }))) satisfies GetStaticPaths;

interface Props {
	location: Location;
}

const { location: loc } = Astro.props;
const local = loc.projects.map((id) => projects.find((p) => p.id === id)!).filter(Boolean);
// Without local clients yet, show our most recent work instead.
const shown = local.length ? local : recentProjects.slice(0, 3);
const others = locations.filter((l) => l.slug !== loc.slug);
const url = `${site.url}/locations/${loc.slug}`;

const schema = [
	{
		'@type': 'Service',
		'@id': `${url}#service`,
		name: `Website design and development for ${loc.people}`,
		serviceType: 'Web design and development',
		url,
		provider: { '@id': `${site.url}/#organization` },
		areaServed: [
			{ '@type': 'Country', name: loc.country },
			...loc.cities.map((c) => ({ '@type': 'City', name: c, containedInPlace: { '@type': 'Country', name: loc.country } })),
		],
	},
	faqSchema(loc.faqs),
];
const crumbs = [
	{ name: 'Where we work', path: '/locations' },
	{ name: loc.country, path: `/locations/${loc.slug}` },
];
---
<BaseLayout title={loc.meta.title} description={loc.meta.description} keywords={loc.meta.keywords} image={shown[0]?.image} breadcrumbs={crumbs} schema={schema}>
	<PageHero crumbs={crumbs} title={loc.title} lead={loc.lead}>
		<Fragment slot="actions">
			<Button href="#discovery" variant="dark">Get a free quote</Button>
			<Button href="#work" variant="ghost" icon={false}>{local.length ? `See our work in ${loc.short}` : 'See our work'}</Button>
		</Fragment>
		<div class="lhero__meta" data-reveal style="--d:400">
			<span class="lhero__flag"><img src={`/assets/images/flags/${loc.code}.svg`} alt="" width="28" height="21" /> {loc.country}</span>
			<ul class="lhero__cities" role="list" aria-label="Cities we serve">
				{loc.cities.map((c) => <li>{c}</li>)}
			</ul>
		</div>
		<div slot="aside"><WorkStack projects={shown} /></div>
	</PageHero>

	<!-- Local work -->
	<section class="section lwork" id="work">
		<div class="container">
			<div class="lwork__head">
				<h2 class="h2" data-split>{local.length ? `Websites we built for ${loc.people}` : 'Recent work for clients worldwide'}</h2>
				<p class="subtitle" data-reveal>
					{local.length
						? `Live websites for clients in ${loc.short}. Open any of them for the full case study.`
						: `Our latest projects for businesses in the UK, Australia, the US and beyond. The same team and process work for ${loc.people}.`}
				</p>
			</div>
			<ul class="lwork__grid" role="list">
				{shown.map((p, i) => (
					<li data-reveal style={`--d:${(i % 3) * 70}`}><ProjectCard project={p} /></li>
				))}
			</ul>
		</div>
	</section>

	<!-- Why work with us from here -->
	<section class="section lwhy">
		<div class="container">
			<div class="frame brackets lwhy__frame">
				<div class="lwhy__intro">
					<h2 class="h2" data-split>Why {loc.people} work with us</h2>
					<p class="lwhy__tz" data-reveal><Icon name="clock" size={18} /> {loc.timezone}</p>
					<div data-reveal><Button href="#discovery" variant="dark">Book a free call</Button></div>
				</div>
				<ol class="lwhy__list" role="list">
					{loc.points.map((pt, i) => (
						<li class="lpoint" data-reveal>
							<span class="lpoint__n">[{i + 1}]</span>
							<h3 class="lpoint__t">{pt.title}</h3>
							<p>{pt.text}</p>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<WhatWeBuild title={`What we build for ${loc.people}`} subtitle={`Every service, delivered remotely for clients in ${loc.cities.slice(0, 3).join(', ')} and across ${loc.short}.`} />

	<Faq items={loc.faqs} title={`Questions from ${loc.people}`} />

	<section class="section section--tight lother">
		<div class="container">
			<h2 class="lother__title">We also work with businesses in</h2>
			<ul class="lother__list" role="list">
				{others.map((o) => (
					<li><a href={`/locations/${o.slug}`}><img src={`/assets/images/flags/${o.code}.svg`} alt="" width="22" height="16" /> {o.country}</a></li>
				))}
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.lhero__meta {
		display: grid;
		gap: 14px;
		margin-top: 8px;
		padding-top: 22px;
		border-top: 1px solid var(--line);
		width: 100%;
	}

	.lhero__flag {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 550;
	}

	.lhero__flag img {
		width: 28px;
		height: 21px;
		object-fit: cover;
		border-radius: 2px;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
	}

	.lhero__cities {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
	}

	.lhero__cities li {
		padding: 6px 12px;
		border: 1px solid var(--line-2);
		font-size: 0.875rem;
	}

	/* Local work */
	.lwork__head {
		display: grid;
		gap: 16px;
		margin-bottom: clamp(32px, 4vw, 48px);
	}

	.lwork__grid {
		display: grid;
		gap: 20px;
		margin: 0;
	}

	@media (min-width: 700px) {
		.lwork__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1100px) {
		.lwork__grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Why */
	.lwhy__frame {
		display: grid;
	}

	@media (min-width: 1024px) {
		.lwhy__frame {
			grid-template-columns: 0.9fr 1.1fr;
		}

		.lwhy__list {
			border-left: 1px solid var(--line);
		}
	}

	.lwhy__intro {
		display: grid;
		gap: 22px;
		align-content: start;
		justify-items: start;
		padding: clamp(28px, 4vw, 64px);
	}

	.lwhy__tz {
		display: flex;
		gap: 12px;
		max-width: 46ch;
		color: var(--ink-soft);
		line-height: 1.6;
	}

	.lwhy__tz :global(svg) {
		margin-top: 3px;
		color: var(--green-ink);
	}

	.lwhy__list {
		display: grid;
		margin: 0;
	}

	.lpoint {
		display: grid;
		gap: 10px;
		padding: clamp(24px, 3vw, 40px);
		border-top: 1px solid var(--line);
	}

	@media (min-width: 1024px) {
		.lpoint:first-child {
			border-top: 0;
		}
	}

	.lpoint__n {
		color: var(--green-ink);
		font-size: 0.9375rem;
	}

	.lpoint__t {
		font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem);
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.lpoint p {
		max-width: 56ch;
		color: var(--muted);
		line-height: 1.6;
	}

	/* Other countries */
	.lother__title {
		margin-bottom: 20px;
		font-size: 1.25rem;
		font-weight: 500;
	}

	.lother__list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
	}

	.lother__list a {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 48px;
		padding: 0 18px;
		border: 1px solid var(--line-2);
		transition:
			background 0.3s,
			color 0.3s,
			border-color 0.3s;
	}

	.lother__list img {
		width: 22px;
		height: 16px;
		object-fit: cover;
		border-radius: 2px;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
	}

	.lother__list a:hover {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--white);
	}
</style>

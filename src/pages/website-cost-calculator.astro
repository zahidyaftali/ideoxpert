---
// /website-cost-calculator: instant price range and timeline, no email needed.
// All questions, the default estimate and a <noscript> price table are in the
// static HTML; src/scripts/pricing-calculator.ts adds the interactivity.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ChoiceCard from '../components/ChoiceCard.astro';
import Faq from '../components/Faq.astro';
import { site, whatsappLink } from '../data/site';
import { projects } from '../data/projects';
import { faqSchema } from '../data/faqs';
import { apps, calculatorFaqs, care, currencyList, hosting, money, oneOff, seo, store, website } from '../data/pricing';
import { calculateEstimate, defaults, formatOneOff, needs, timelineLine, toQuery, type Answers } from '../scripts/pricing-calculator.ts';

const usd = (n: number) => money(n, 'USD');
// What the page shows before any clicks: a 2-5 page website.
const start: Answers = { ...defaults, need: ['website'] };
const est = calculateEstimate(start, 'USD');

// "What similar projects cost": real projects, priced as the same setup today.
const similar = [
	{ id: 'smbelectrical-ca', text: 'A site like this today: about 8 pages, our layouts, contact and quote forms.', answers: { ...defaults, need: ['website'], pages: '6-10', extras: ['forms'] } as Answers },
	{ id: 'flechtarbeiten-de', text: 'A store like this today: up to 25 products, card payments.', answers: { ...defaults, need: ['store'], products: '25' } as Answers },
	{ id: 'gahealthcaretraining-com', text: 'A site like this today: 6–10 pages with online booking.', answers: { ...defaults, need: ['website'], pages: '6-10', extras: ['booking'] } as Answers },
].map((s) => ({ ...s, p: projects.find((p) => p.id === s.id)!, range: formatOneOff(calculateEstimate(s.answers, 'USD')), href: `/website-cost-calculator?${toQuery(s.answers, 'USD')}` }));

const url = `${site.url}/website-cost-calculator`;
const schema = [
	{
		'@type': 'WebApplication',
		name: 'Website cost calculator',
		url,
		applicationCategory: 'BusinessApplication',
		operatingSystem: 'Any',
		isAccessibleForFree: true,
		offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
		provider: { '@id': `${site.url}/#organization` },
	},
	faqSchema(calculatorFaqs),
];
const crumbs = [
	{ name: 'Pricing', path: '/pricing' },
	{ name: 'Cost calculator', path: '/website-cost-calculator' },
];
---
<BaseLayout
	title="Website Cost Calculator: Instant Estimate | IdeoXpert"
	description="How much will your website cost? Answer a few quick questions and get an instant price range and timeline. No email needed to see your estimate."
	keywords="website cost calculator, how much does a website cost, website price estimate, e-commerce website cost, small business website cost"
	breadcrumbs={crumbs}
	schema={schema}
>
	<PageHero
		crumbs={crumbs}
		title="How much will your <b>website cost</b>?"
		lead="Answer a few quick questions. You’ll see a price range and a timeline straight away, with no email needed. When you’re happy, send it to us and we’ll turn it into a fixed quote."
	>
		<ul class="calc-trust" role="list" data-reveal style="--d:300">
			<li><Icon name="clock" size={18} /> Takes about a minute</li>
			<li><Icon name="check" size={18} /> No email needed</li>
			<li><Icon name="spark" size={18} /> Fixed quote within 24 hours</li>
		</ul>
	</PageHero>

	<section class="section section--flush calc-sec" aria-label="Website cost calculator">
		<div class="container calc">
			<form class="calc__form" data-calc onsubmit="return false">
				<fieldset class="calc-q">
					<legend class="calc-q__legend">What do you need?</legend>
					<p class="calc-q__why">Tick one or more. The questions for each one appear below.</p>
					<div class="calc-q__opts">
						{needs.map((n) => <ChoiceCard type="checkbox" name="need" value={n.id} title={n.label} desc={n.desc} checked={start.need.includes(n.id)} />)}
					</div>
				</fieldset>

				<!-- Website -->
				<div class="calc-group" data-group="website">
					<h2 class="calc-group__title">Your website</h2>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">How many pages?</legend>
						<p class="calc-q__why">Each page needs design, content and testing, so more pages means more work. Not sure? Most small businesses need 5 to 8: Home, About, one page per main service, and Contact.</p>
						<div class="calc-q__opts">
							{website.pages.map((p) => <ChoiceCard type="radio" name="pages" value={p.id} title={p.label} desc={p.desc} checked={p.id === start.pages} price={{ usd: p.price, prefix: p.from ? 'from ' : '' }} />)}
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Design</legend>
						<p class="calc-q__why">Our proven layouts are quicker and still look like your brand. A fully custom design is drawn from scratch, just for you.</p>
						<div class="calc-q__opts">
							{website.design.map((d) => (
								<ChoiceCard type="radio" name="design" value={d.id} title={d.label} desc={d.price ? `${d.desc}. ${usd(d.onePagePrice)} for a one-page site.` : d.desc} checked={d.id === start.design} price={{ usd: d.price, prefix: '+' }} />
							))}
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Who writes the text?</legend>
						<p class="calc-q__why">Good words win customers. If you don’t have time, we’ll write clear, search-friendly text for each page after a short questionnaire.</p>
						<div class="calc-q__opts">
							{website.copy.map((c) => <ChoiceCard type="radio" name="copy" value={c.id} title={c.label} checked={c.id === start.copy} price={{ usd: c.perPage, kind: 'unit', prefix: '+', suffix: ' per page' }} />)}
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Extras</legend>
						<p class="calc-q__why">Only tick what you need now. You can add more later.</p>
						<div class="calc-q__opts">
							{website.extras.map((e) => <ChoiceCard type="checkbox" name="extras" value={e.id} title={e.label} desc={e.desc} price={{ usd: e.price, prefix: '+' }} />)}
							{website.included.map((i) => <ChoiceCard type="checkbox" name="included" value={i} title={i} checked disabled tag="Included" />)}
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Do you have a website now?</legend>
						<p class="calc-q__why">We move your pages, images and blog posts across, and redirect the old addresses so you keep your Google rankings.</p>
						<div class="calc-q__opts">
							{website.existing.map((o) => <ChoiceCard type="radio" name="existing" value={o.id} title={o.label} desc={o.desc || undefined} checked={o.id === start.existing} price={{ usd: o.price, prefix: '+' }} />)}
						</div>
					</fieldset>
				</div>

				<!-- Online store -->
				<div class="calc-group" data-group="store">
					<h2 class="calc-group__title">Your online store</h2>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">How many products?</legend>
						<p class="calc-q__why">Stores with more products need more setup, categories and testing.</p>
						<div class="calc-q__opts">
							{store.products.map((p) => <ChoiceCard type="radio" name="products" value={p.id} title={p.label} desc={p.desc} checked={p.id === start.products} price={{ usd: p.price, prefix: p.from ? 'from ' : '' }} />)}
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Platform</legend>
						<p class="calc-q__why">Both are good. WooCommerce has no monthly platform fee. Shopify is the easiest to run yourself. Not sure? We’ll advise.</p>
						<div class="calc-q__opts">
							{store.platform.map((p) => <ChoiceCard type="radio" name="platform" value={p.id} title={p.label} desc={p.note ? `${p.desc}. ${p.note}` : p.desc} checked={p.id === start.platform} />)}
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Who adds the products?</legend>
						<p class="calc-q__why">Adding photos, prices and sizes takes time. We can do it for you.</p>
						<div class="calc-q__opts">
							{store.adding.map((a) => <ChoiceCard type="radio" name="adding" value={a.id} title={a.label} checked={a.id === start.adding} price={{ usd: a.perProduct, kind: 'unit', prefix: '+', suffix: ' per product' }} />)}
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Extras</legend>
						<p class="calc-q__why">Only tick what you need for launch.</p>
						<div class="calc-q__opts">
							{store.extras.map((e) => <ChoiceCard type="checkbox" name="store_extras" value={e.id} title={e.label} desc={e.desc} price={{ usd: e.price, prefix: '+' }} />)}
							{store.included.map((i) => <ChoiceCard type="checkbox" name="store_included" value={i} title={i} checked disabled tag="Included" />)}
						</div>
					</fieldset>
				</div>

				<!-- SEO -->
				<div class="calc-group" data-group="seo">
					<h2 class="calc-group__title">More customers from Google</h2>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Where are your customers?</legend>
						<p class="calc-q__why">Ranking in one town is quicker and costs less than ranking nationwide, because there’s less competition.</p>
						<div class="calc-q__opts">
							{seo.area.map((a) => (
								<ChoiceCard type="radio" name="area" value={a.id} title={a.label} desc={a.monthly === null ? seo.customNote : undefined} checked={a.id === start.area} price={a.monthly === null ? undefined : { usd: a.monthly, kind: 'monthly', suffix: '/month' }} tag={a.monthly === null ? 'Custom quote' : undefined} />
							))}
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Blog articles per month</legend>
						<p class="calc-q__why">Useful articles answer your customers’ questions and bring in visitors from Google over time.</p>
						<div class="calc-q__opts">
							{seo.articles.map((a) => <ChoiceCard type="radio" name="articles" value={a.id} title={a.label} checked={a.id === start.articles} price={{ usd: a.monthly, kind: 'monthly', prefix: '+', suffix: '/month' }} />)}
						</div>
					</fieldset>
					<p class="calc-note">Every SEO plan starts with a one-off setup of <span data-usd={seo.setup} data-kind="oneoff">{usd(seo.setup)}</span>: an audit, technical fixes, Google Business Profile setup, and Search Console and Analytics setup. {seo.note}</p>
				</div>

				<!-- App -->
				<div class="calc-group" data-group="app">
					<h2 class="calc-group__title">Your app</h2>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">What kind of app?</legend>
						<p class="calc-q__why">Apps vary a lot, so we show a range. Your answers help us prepare for the call.</p>
						<div class="calc-q__opts">
							{apps.types.map((t) => <ChoiceCard type="radio" name="app" value={t.id} title={t.label} desc={t.desc} checked={t.id === start.app} rangeUsd={t.range} />)}
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Do users need to log in?</legend>
						<div class="calc-q__opts calc-q__opts--2">
							<ChoiceCard type="radio" name="login" value="yes" title="Yes" />
							<ChoiceCard type="radio" name="login" value="no" title="No" />
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Does it need to connect to another system?</legend>
						<div class="calc-q__opts calc-q__opts--2">
							<ChoiceCard type="radio" name="connect" value="yes" title="Yes" desc="For example a CRM, payment or booking system" />
							<ChoiceCard type="radio" name="connect" value="no" title="No" />
						</div>
					</fieldset>
				</div>

				<!-- Hosting and care -->
				<div class="calc-group" data-group="hosting">
					<h2 class="calc-group__title">Hosting and care</h2>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Hosting plan</legend>
						<p class="calc-q__why">Every website needs hosting. Ours includes backups, SSL and support.</p>
						<div class="calc-q__opts">
							<ChoiceCard type="radio" name="hosting" value="none" title="No hosting" desc="I have hosting already" checked={start.hosting === 'none'} />
							{hosting.plans.map((p) => <ChoiceCard type="radio" name="hosting" value={p.id} title={p.name} desc={p.desc} host={{ id: p.id, usd: p.monthly.USD }} />)}
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Billing</legend>
						<div class="calc-q__opts calc-q__opts--2">
							<ChoiceCard type="radio" name="billing" value="monthly" title="Monthly" checked={start.billing === 'monthly'} />
							<ChoiceCard type="radio" name="billing" value="annual" title="Annual" desc={`Save ${hosting.annualSaving}%, billed once a year`} />
						</div>
					</fieldset>
					<fieldset class="calc-q">
						<legend class="calc-q__legend">Care plan</legend>
						<p class="calc-q__why">Updates and security checks so nothing breaks.</p>
						<div class="calc-q__opts">
							<ChoiceCard type="radio" name="care" value="none" title="No care plan" checked={start.care === 'none'} />
							{care.plans.map((p) => <ChoiceCard type="radio" name="care" value={p.id} title={p.name} desc={p.desc} price={{ usd: p.monthly, kind: 'monthly', suffix: '/month' }} />)}
						</div>
					</fieldset>
				</div>
			</form>

			<!-- Summary -->
			<aside class="calc__side">
				<div class="est" data-est data-whatsapp={site.whatsapp} id="summary">
					<div class="est__top">
						<h2 class="est__title">Your estimate</h2>
						<fieldset class="est__cur">
							<legend class="sr-only">Currency</legend>
							{currencyList.map((c) => (
								<label><input type="radio" name="cur" value={c} checked={c === 'USD'} /><span>{c}</span></label>
							))}
						</fieldset>
					</div>
					<p class="est__empty" data-est-empty hidden={!est.empty}>Pick what you need on the left and your estimate appears here.</p>
					<div data-est-body hidden={est.empty}>
						<div class="est__live" aria-live="polite" aria-atomic="true">
							<p class="est__range" data-est-range>{formatOneOff(est)}</p>
							<ul class="est__monthly" role="list" data-est-monthly hidden={!est.monthly.length}>
								{est.monthly.map((m) => <li>+ {usd(m.amount)}/month {m.label}</li>)}
							</ul>
							<p class="est__time" data-est-time><Icon name="clock" size={15} /> <span>{timelineLine(est)}</span></p>
						</div>
						<h3 class="est__sub">What’s included</h3>
						<ul class="est__inc" role="list" data-est-included>
							{est.included.map((i) => <li>{i}</li>)}
						</ul>
						<ul class="est__notes" role="list" data-est-notes hidden={!est.notes.length}>
							{est.notes.map((n) => <li>{n}</li>)}
						</ul>
					</div>
					<p class="est__honest">This is an estimate, not an invoice. We’ll confirm a fixed price after a short chat or a few messages. The fixed price is what you pay: anything extra is agreed with you first.</p>
					<div class="est__btns">
						<Button type="button" variant="primary" data-calc-quote>Get my fixed quote</Button>
						<Button type="button" variant="ghost" icon="whatsapp" data-calc-wa>Send to WhatsApp</Button>
						<button type="button" class="est__reset" data-calc-reset>Start again</button>
					</div>
				</div>
			</aside>
		</div>

		<noscript>
			<div class="container calc-noscript">
				<h2 class="h3">Our starting prices</h2>
				<table>
					<caption class="sr-only">Starting prices in US dollars</caption>
					<thead><tr><th scope="col">What</th><th scope="col">Price</th></tr></thead>
					<tbody>
						{website.pages.map((p) => <tr><td>Website, {p.label}</td><td>{p.from ? 'from ' : ''}{usd(p.price)}</td></tr>)}
						{store.products.map((p) => <tr><td>Online store, {p.label.toLowerCase()} products</td><td>{p.from ? 'from ' : ''}{usd(p.price)}</td></tr>)}
						<tr><td>SEO setup (one-off)</td><td>{usd(seo.setup)}</td></tr>
						{seo.area.map((a) => <tr><td>SEO, {a.label.toLowerCase()}</td><td>{a.monthly === null ? 'Custom quote' : `${usd(a.monthly)}/month`}</td></tr>)}
						{apps.types.map((t) => <tr><td>{t.label}</td><td>{usd(t.range[0])}–{usd(t.range[1])}</td></tr>)}
						{hosting.plans.map((p) => <tr><td>{p.name} hosting</td><td>{usd(p.monthly.USD)}/month</td></tr>)}
						{care.plans.map((p) => <tr><td>{p.name} plan</td><td>{usd(p.monthly)}/month</td></tr>)}
					</tbody>
				</table>
			</div>
		</noscript>
	</section>

	<!-- Phones: the estimate stays in view -->
	<div class="calc-bar" data-calc-bar data-empty="false" data-in-view="false">
		<span class="calc-bar__range" data-bar-range>Estimate: {formatOneOff(est)}</span>
		<button type="button" class="calc-bar__btn" data-bar-summary>See summary</button>
	</div>

	<!-- How the price is worked out -->
	<section class="section calc-how">
		<div class="container calc-how__grid">
			<h2 class="h2" data-split>How we work out <b>your price</b></h2>
			<div class="calc-how__text">
				<p data-reveal>We price by the time each part takes: pages, features and setup. We don’t charge more because of your industry, your company size or where you’re based.</p>
				<p data-reveal>The range covers the small things we only find out once we’ve talked, like how much content you have or a feature that needs extra work. Most fixed quotes land in the lower half.</p>
				<p data-reveal>Prefer to talk it through? <a class="link link--green" href={whatsappLink('the cost calculator')} target="_blank" rel="noopener">Message us on WhatsApp</a> and we’ll help you pick the right options. You can also see <a class="link link--green" href="/pricing">all our prices</a> or <a class="link link--green" href="/portfolio">the websites we’ve built</a>.</p>
			</div>
		</div>
	</section>

	<!-- Similar projects -->
	<section class="section section--tint calc-sim">
		<div class="container">
			<div class="stack calc-sim__head">
				<h2 class="h2" data-split>What <b>similar projects</b> cost</h2>
				<p class="subtitle" data-reveal>Real websites from our portfolio, priced as the same setup would cost today.</p>
			</div>
			<ul class="calc-sim__grid" role="list" data-reveal-group="80">
				{similar.map((s) => (
					<li class="scard2" data-reveal>
						<a class="scard2__img" href={`/work/${s.p.slug}`}><img src={s.p.thumb} alt={`${s.p.name} website by IdeoXpert`} width="800" height="500" loading="lazy" decoding="async" /></a>
						<div class="scard2__body">
							<p class="scard2__name"><a href={`/work/${s.p.slug}`}>{s.p.name}</a></p>
							<p class="scard2__text">{s.text}</p>
							<p class="scard2__label">Typical price for a similar site today</p>
							<p class="scard2__price">{s.range}</p>
							<a class="link link--green" href={s.href}>Try these answers <Icon name="arrow-right" /></a>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>

	<Faq items={calculatorFaqs} title="Questions about <b>the estimate</b>" id="calculator-faq" />
</BaseLayout>

<script>
	import '../scripts/pricing-calculator';
</script>

<style>
	.calc-trust {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 28px;
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.calc-trust li {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.calc-trust :global(svg) {
		color: var(--green-ink);
	}

	/* ---------- Layout: questions left, sticky summary right ---------- */
	/* A shorter hero on this page, so the calculator starts above the fold. */
	:global(.page-hero) {
		padding-bottom: 24px;
	}

	.calc-sec {
		padding-bottom: clamp(56px, 7vw, 104px);
	}

	.calc {
		display: grid;
		gap: 32px;
		align-items: start;
	}

	@media (min-width: 1024px) {
		.calc {
			grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr);
			gap: 40px;
		}

		.calc__side {
			position: sticky;
			top: calc(var(--header-h) + 24px);
		}
	}

	.calc__form {
		display: grid;
		gap: 28px;
		min-width: 0;
	}

	.calc-q {
		display: grid;
		gap: 12px;
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}

	.calc-q__legend {
		padding: 0;
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.calc-q__why {
		max-width: 70ch;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.calc-q__opts {
		display: grid;
		gap: 10px;
	}

	@media (min-width: 640px) {
		.calc-q__opts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.calc-group {
		display: grid;
		gap: 28px;
		padding: clamp(20px, 3vw, 32px);
		background: var(--card);
		border: 1px solid var(--line);
	}

	.calc-group[hidden] {
		display: none;
	}

	.calc-group.is-entering {
		animation: calc-in 0.35s var(--ease-out);
	}

	@keyframes calc-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.calc-group.is-entering {
			animation: none;
		}
	}

	.calc-group__title {
		font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.calc-note {
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--ink-soft);
		padding: 14px 16px;
		background: var(--green-50);
	}

	/* ---------- Summary ---------- */
	.est {
		display: grid;
		gap: 18px;
		padding: clamp(22px, 2.6vw, 30px);
		background: var(--night);
		color: var(--on-night-muted);
	}

	.est__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.est__title {
		font-size: 1.125rem;
		font-weight: 600;

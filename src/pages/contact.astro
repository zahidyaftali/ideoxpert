---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ProjectForm from '../components/ProjectForm.astro';
import Person from '../components/Person.astro';
import { site, contactPerson, whatsappLink } from '../data/site';

// What happens after you get in touch (same as under the form).
const steps = [
	{ icon: 'mail', title: 'We reply', text: `Within ${site.replyTime.replace(/^within /, '')}, by email or WhatsApp, whichever you prefer.` },
	{ icon: 'search', title: 'We look at your current site', text: 'If you have one, we check what works, what does not, and what is costing you inquiries.' },
	{ icon: 'check', title: 'You get a plan and a price', text: 'What we would build, how long it takes and what it costs. No obligation.' },
] as const;
---
<BaseLayout
	title="Contact IdeoXpert | Free Website Consultation"
	description={`Contact IdeoXpert, a web development agency in Islamabad, Pakistan, about web design, development, SEO or e-commerce. We reply ${site.replyTime}.`}
	keywords="contact IdeoXpert, web development agency contact, free website quote, hire web developer, website design consultation, web solutions Pakistan, IdeoXpert contact"
	image="/assets/images/ideo expert-02.png"
	pageType="ContactPage"
	discovery={false}
	breadcrumbs={[{ name: 'Contact Us', path: '/contact' }]}
>
	<section class="section section--flush contact">
		<div class="container">
			<div class="frame brackets contact__frame">
				<div class="contact__intro">
					<div class="tex-layer tex-dots contact__dots" aria-hidden="true"></div>
					<h1 class="h1" data-split>Let's talk about your project<span class="dot">.</span></h1>
					<p class="contact__lead" data-reveal>Tell us about your idea, ask for a quote, or ask for honest advice about the site you have. Here is what happens next.</p>

					<ol class="csteps" role="list" data-reveal-group="80">
						{steps.map((s) => (
							<li class="cstep" data-reveal>
								<span class="cstep__icon"><Icon name={s.icon} size={18} /></span>
								<div>
									<h2 class="cstep__title">{s.title}</h2>
									<p>{s.text}</p>
								</div>
							</li>
						))}
					</ol>

					<div class="ccards" data-reveal-group="80">
						<a class="ccard" href={`mailto:${site.email}`} data-reveal>
							<span class="ccard__label"><Icon name="mail" size={16} /> Email us</span>
							<strong>{site.email}</strong>
						</a>
						<a class="ccard" href={whatsappLink()} target="_blank" rel="noopener" data-reveal>
							<span class="ccard__label"><Icon name="whatsapp" size={16} /> Call or WhatsApp</span>
							<strong>{site.phoneDisplay}</strong>
						</a>
					</div>
					<div class="contact__person" data-reveal><Person person={contactPerson} line="who will plan and oversee your project." /></div>
				</div>

				<ProjectForm id="form" form="contact" class="contact__form" />
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.contact {
		padding-top: calc(var(--topbar-h) + var(--header-h));
		padding-bottom: clamp(56px, 7vw, 104px);
	}

	.contact__frame {
		display: grid;
	}

	@media (min-width: 1024px) {
		.contact__frame {
			grid-template-columns: 1fr 1fr;
		}
	}

	.contact__intro {
		position: relative;
		isolation: isolate;
		display: grid;
		gap: 28px;
		align-content: start;
		justify-items: start;
		padding: clamp(32px, 5vw, 80px) clamp(24px, 4.5vw, 72px);
	}

	.contact__dots {
		-webkit-mask-image: radial-gradient(ellipse 70% 50% at 20% 10%, #000 10%, transparent 70%);
		mask-image: radial-gradient(ellipse 70% 50% at 20% 10%, #000 10%, transparent 70%);
		opacity: 0.8;
	}

	.contact__lead {
		max-width: 46ch;
		font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
		line-height: 1.55;
		color: var(--ink-soft);
	}

	.csteps {
		display: grid;
		gap: 24px;
		margin: 8px 0 0;
	}

	.cstep {
		display: grid;
		grid-template-columns: 40px 1fr;
		gap: 16px;
	}

	.cstep__icon {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--green-50);
		color: var(--green-ink);
	}

	.cstep__title {
		margin-bottom: 4px;
		font-size: 1.1875rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		color: var(--green-ink);
	}

	.cstep p {
		color: var(--ink-soft);
		max-width: 48ch;
	}

	.ccards {
		display: grid;
		gap: 12px;
		width: 100%;
		margin-top: 8px;
	}

	@media (min-width: 640px) {
		.ccards {
			grid-template-columns: 1fr 1fr;
		}
	}

	.ccard {
		display: grid;
		gap: 10px;
		padding: 20px;
		background: var(--paper-2);
		transition: background 0.3s;
	}

	.ccard:hover {
		background: var(--green-100);
	}

	.ccard__label {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.ccard strong {
		font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		overflow-wrap: anywhere;
	}

	/* ---------- Form ---------- */
	:global(.contact__form) {
		padding: clamp(28px, 4.5vw, 64px);
		border-top: 1px solid var(--line);
	}

	@media (min-width: 1024px) {
		:global(.contact__form) {
			border-top: 0;
			border-left: 1px solid var(--line);
		}
	}
</style>

<script>
	import '../scripts/mail-form';
</script>

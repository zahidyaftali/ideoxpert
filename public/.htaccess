# IdeoXpert - Apache / LiteSpeed configuration for the Astro build.
# Upload the contents of dist/ (including this file) to public_html.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# /blog, /industries and /locations are pages (blog.html...) that share their
# name with a folder (blog/ holds the articles). Without this the server adds
# a slash (/blog/) and refuses to list the folder: 403 Forbidden. The rewrite
# in step 3 serves the page instead.
<IfModule mod_dir.c>
DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Every redirect below points straight at https://ideoxpert.com/..., and the
# old-URL rules (1, 2) come before the domain rule (3). An old address on www
# or http therefore reaches its final page in one redirect, not two. The path
# and the query string are kept. (Hostinger's CDN sends http to https before
# these rules run, so an http://www address still takes one extra step.)

# 1. Old or duplicate URLs. THE_REQUEST is the visitor's original request, so
#    the server's own internal lookup of index.html for "/" is not redirected.
RewriteCond %{THE_REQUEST} \s/index(\.html)?[\s?] [NC]
RewriteRule ^index(\.html)?$ https://ideoxpert.com/ [R=301,L]
# The old site's home page.
RewriteRule ^home(\.html)?/?$ https://ideoxpert.com/ [NC,R=301,L]
RewriteRule ^integrations/?$ https://ideoxpert.com/services [R=301,L]
RewriteRule ^work/?$ https://ideoxpert.com/portfolio [R=301,L]
RewriteRule ^website\sdevelopment/?$ https://ideoxpert.com/website-development [R=301,L]
# /Website-development: the old site used a capital W. Any spelling that is
# not all lower case goes to the real page. The condition stops a loop, and
# the pattern must not match ".html" (rule 4 rewrites to that name).
RewriteCond %{REQUEST_URI} !^/website-development/?$
RewriteRule ^website-development/?$ https://ideoxpert.com/website-development [NC,R=301,L]
# The founder's own site was removed from the client portfolio.
RewriteRule ^work/zahid-ali-yaftali(\.html)?/?$ https://ideoxpert.com/portfolio [R=301,L]
# Industries renamed or regrouped (Oct 2026).
RewriteRule ^industries/trades-home-services(\.html)?/?$ https://ideoxpert.com/industries/home-services [R=301,L]
RewriteRule ^industries/healthcare-wellness(\.html)?/?$ https://ideoxpert.com/industries/healthcare [R=301,L]
RewriteRule ^industries/restaurants-hospitality(\.html)?/?$ https://ideoxpert.com/industries/hospitality [R=301,L]
RewriteRule ^industries/media-entertainment(\.html)?/?$ https://ideoxpert.com/industries [R=301,L]
# UI/UX design is no longer offered as a separate service.
RewriteRule ^ux-ui-design(\.html)?/?$ https://ideoxpert.com/website-design [R=301,L]

# 2. Clean URLs: /about.html -> /about (301).
RewriteCond %{THE_REQUEST} \s/([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ https://ideoxpert.com/%1 [R=301,L]

# 3. One domain only: send http:// and www. to https://ideoxpert.com (301).
#    If the site sits behind a proxy/CDN that terminates SSL and you get a
#    redirect loop, delete the "%{HTTPS} off" line and keep the www line.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://ideoxpert.com/$1 [R=301,L]

# 4. /about serves about.html. This also applies when a folder of the same
# name exists (/blog -> blog.html, not the blog/ folder). /blog/ is served too
# rather than redirected, so browsers that cached the old /blog -> /blog/
# redirect cannot loop; the canonical tag on the page points to /blog.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
# Browsers remember to use https (they ignore this header on plain http).
Header always set Strict-Transport-Security "max-age=31536000"

# Astro's CSS and JS in /_astro/ have a content hash in the file name, so they
# can be cached for a year: a changed file always gets a new name.
SetEnvIf Request_URI "^/_astro/" ASTRO_ASSET
Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_ASSET
</IfModule>

# Compress text files (LiteSpeed on Hostinger also serves Brotli on its own).
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# Browser caching for static files.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/webp "access plus 6 months"
ExpiresByType image/avif "access plus 6 months"
ExpiresByType image/svg+xml "access plus 6 months"
ExpiresByType image/x-icon "access plus 6 months"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/woff "access plus 1 year"
ExpiresByType application/rss+xml "access plus 1 hour"
ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Mail settings for api/send-mail.php are never served to browsers.
<FilesMatch "^(ideoxpert-)?mail-config.*\.php$">
Require all denied
</FilesMatch>
